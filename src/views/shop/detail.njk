{% extends 'base.njk' %}{% block body %}<main class="section"><div class="grid two"><div><img class="detail-img" src="{{p.image}}"></div><div><span class="eyebrow">{{p.category|upper}}</span><h1>{{p.name}}</h1><p>{{p.description}}</p><h2>${{p.price}} UYU</h2><p>{{p.size}} · {{p.stock}} unidades disponibles</p><form method="post" action="/carrito/agregar/{{p.id}}"><button class="btn" {% if p.stock==0 %}disabled{% endif %}>Agregar al carrito</button></form><a class="wa-inline" target="_blank" href="https://wa.me/{{wa}}?text=Hola%20Dulce29,%20quiero%20consultar%20por%20{{p.name|urlencode}}">Consultar por WhatsApp</a>{% if p.video %}<h3>Video de ejemplo</h3><div class="video"><iframe src="{{p.video}}" allowfullscreen></iframe></div>{% endif %}</div></div></main>{% endblock %}
