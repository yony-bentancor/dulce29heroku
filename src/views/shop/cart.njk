{% extends 'base.njk' %}{% block body %}<main class="narrow"><span class="eyebrow">TU COMPRA</span><h1>Carrito</h1>{% for x in rows %}<div class="cartrow"><img src="{{x.p.image}}"><div><b>{{x.p.name}}</b><small>{{x.qty}} × ${{x.p.price}}</small></div><strong>${{x.qty*x.p.price}}</strong></div>{% else %}<p>Tu carrito está vacío.</p>{% endfor %}{% if rows|length %}<h2>Total ${{total}}</h2><a class="btn" href="/checkout">Continuar al checkout</a>{% endif %}</main>{% endblock %}
