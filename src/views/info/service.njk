{% extends 'base.njk' %}{% block content %}<section class="service-hero"><div><span class="kicker">{{service.eyebrow|upper}}</span><h1>{{service.title}}</h1><p>{{service.desc}}</p><ul>{% for x in service.points %}<li>✓ {{x}}</li>{% endfor %}</ul><a class="btn primary" href="/contacto?tema={{key}}">Quiero información →</a></div><div class="service-art">{{service.emoji}}<small>{{service.title}}</small></div></section><section class="section"><div class="steps"><div><b>01</b><h3>Informate</h3><p>Conocé qué ofrece el servicio y para quién puede ser útil.</p></div><div><b>02</b><h3>Consultá</h3><p>Dejanos tus datos para conversar y resolver dudas.</p></div><div><b>03</b><h3>Coordiná</h3><p>El equipo Dulce29 continúa el proceso de forma personalizada.</p></div></div></section>{% endblock %}
