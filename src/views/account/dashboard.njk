{% extends 'base.njk' %}{% block content %}<section class="account"><div class="account-nav"><b>MI DULCE29</b><a class="active" href="/mi-cuenta">Resumen</a><a href="/mi-cuenta/pedidos">Mis pedidos</a><a href="/tienda">Comprar</a><a href="/mi-cuenta/perfil">Mi perfil</a></div><div class="account-main">{% set eyebrow='TU ESPACIO' %}{% set title='Hola, '+user.name+'.' %}{% set subtitle='Todo lo tuyo, sin complicaciones.' %}{% include 'partials/panel-top.njk' %}<div class="client-hero"><div><small>PRÓXIMO PASO</small><h2>Volvé a elegir<br>lo que te hace bien.</h2><a href="/tienda">Ir al market →</a></div><span>🌿</span></div><h2 class="subhead">Tus pedidos recientes</h2>{% for o in orders %}<div class="order-card"><div><small>#{{o.id}} · {{o.date}}</small><h3>{{o.items|join(' · ')}}</h3></div><em class="status">{{o.status}}</em><strong>$ {{o.total}}</strong></div>{% else %}<div class="empty"><h3>Todavía no tenés pedidos.</h3><p>Tu historial va a aparecer acá.</p></div>{% endfor %}</div></section>{% endblock %}
