{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='CATÁLOGO' %}{% set title='Productos' %}{% set subtitle='Alta, edición y baja de productos demo.' %}{% include 'partials/panel-top.njk' %}<div class="toolbar"><a class="btn primary" href="/admin/productos/nuevo">+ Nuevo producto</a></div><div class="admin-list">{% for p in products %}<div class="admin-row"><span class="admin-emoji">{{p.emoji}}</span><div><small>{{p.id}} · {{p.category|upper}}</small><h3>{{p.name}}</h3></div><span>Stock <b>{{p.stock}}</b></span><strong>$ {{p.price}}</strong><a href="/admin/productos/{{p.id}}/editar">Editar</a><form action="/admin/productos/{{p.id}}/eliminar" method="post" onsubmit="return confirm('¿Eliminar producto?')"><button class="link-danger">Eliminar</button></form></div>{% endfor %}</div></section></div>{% endblock %}
