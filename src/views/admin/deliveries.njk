{% extends 'base.njk' %}{% block body %}<div class="panel">{% include 'partials/admin-nav.njk' %}<main class="panelmain"><span class="eyebrow">COLONIA · LOGÍSTICA</span><h1>Entregas</h1><p>Pedidos, ubicación y contacto en un solo lugar.</p><div class="map"><iframe loading="lazy" src="https://maps.google.com/maps?q=Colonia%20del%20Sacramento%20Uruguay&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe></div><div class="delivery-list">{% for o in orders %}{% set c=clients|selectattr('id','equalto',o.clientId)|first %}{% set d=deliverers|selectattr('id','equalto',o.delivererId)|first %}<article><b>#{{o.id}} · {{c.name}}</b><span>{{o.address}} · {{o.slot}}</span><span>{{o.status}} · {{d.name if d else 'Sin asignar'}}</span><div><a target="_blank" href="https://www.google.com/maps/search/?api=1&query={{o.lat}},{{o.lng}}">📍 Cómo llegar</a><a target="_blank" href="https://wa.me/59895789647?text=Hola%20{{c.name|urlencode}},%20te%20contactamos%20por%20tu%20pedido%20Dulce29%20%23{{o.id}}">💬 WhatsApp cliente</a>{% if d %}<a target="_blank" href="https://wa.me/59895789647?text=Entrega%20Dulce29%20%23{{o.id}}%20-%20{{o.address|urlencode}}">🛵 WhatsApp repartidor</a>{% endif %}</div></article>{% endfor %}</div></main></div>{% endblock %}
