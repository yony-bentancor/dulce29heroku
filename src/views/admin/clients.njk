{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='COMUNIDAD' %}{% set title='Clientes' %}{% set subtitle='Base demo preparada para historial y segmentación.' %}{% include 'partials/panel-top.njk' %}<div class="admin-list">{% for c in clients %}<div class="admin-row"><span class="avatar">{{c.name[0]}}{{c.surname[0]}}</span><div><h3>{{c.name}} {{c.surname}}</h3><small>{{c.email}}</small></div><span>{{c.phone}}</span><span>{{c.address}}</span><a href="#">Ver ficha</a></div>{% endfor %}</div></section></div>{% endblock %}
