{% extends 'base.njk' %}{% block body %}<div class="panel">{% include 'partials/admin-nav.njk' %}<main class="panelmain"><span class="eyebrow">ADMINISTRACIÓN</span><h1>Hola, Natalia</h1><p>Una vista rápida de Dulce29 en Colonia.</p><div class="kpis"><div><small>Ventas demo</small><b>${{sales}}</b></div><div><small>Pedidos</small><b>{{db.orders|length}}</b></div><div><small>Clientes</small><b>{{db.clients|length}}</b></div><div><small>Productos</small><b>{{db.products|length}}</b></div></div><div class="grid two"><section class="card"><h2>Pedidos recientes</h2>{% for o in db.orders %}<p><b>#{{o.id}}</b> · {{o.status}} · ${{o.total}}</p>{% endfor %}<a class="textlink" href="/admin/orders">Gestionar pedidos →</a></section><section class="card"><h2>Atención</h2><p>⚠ Productos con stock bajo: {{lowStock}}</p><p>🚚 Entregas asignadas: {{assigned}}</p><p>💬 Consultas abiertas: {{db.inquiries|length}}</p><a class="textlink" href="/admin/entregas">Abrir logística →</a></section></div></main></div>{% endblock %}
