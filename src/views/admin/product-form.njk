{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='PRODUCTOS' %}{% set title='Editar producto' if product else 'Nuevo producto' %}{% set subtitle='Los cambios viven en memoria hasta conectar MongoDB.' %}{% include 'partials/panel-top.njk' %}<form class="form-card admin-form" method="post"><div class="form-grid"><label>Nombre<input name="name" required value="{{product.name if product}}"></label><label>Categoría<select name="category">{% for c in categories %}<option value="{{c.slug}}" {{'selected' if product and product.category==c.slug}}>{{c.name}}</option>{% endfor %}</select></label><label>Precio UYU<input name="price" type="number" value="{{product.price if product else 0}}"></label><label>Stock<input name="stock" type="number" value="{{product.stock if product else 0}}"></label><label>Etiqueta<input name="badge" value="{{product.badge if product else 'Nuevo'}}"></label><label>Emoji demo<input name="emoji" value="{{product.emoji if product else '🌿'}}"></label><label class="full">Descripción<textarea name="desc" rows="4">{{product.desc if product}}</textarea></label><label class="check full"><input type="checkbox" name="featured" {{'checked' if product and product.featured}}> Destacado en inicio</label></div><button class="btn primary">Guardar →</button></form></section></div>{% endblock %}
