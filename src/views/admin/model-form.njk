{% extends 'base.njk' %}{% block body %}<div class="panel">{% include 'partials/admin-nav.njk' %}<main class="panelmain narrowform"><span class="eyebrow">{{ 'MODIFICAR' if item.id else 'NUEVO' }}</span><h1>{{model.label}}</h1><form class="form" method="post" action="/admin/{{key}}/guardar"><input type="hidden" name="id" value="{{item.id}}"><label>Nombre / título<input name="name" value="{{item.name}}"></label>{% if key=='products' %}<label>Categoría<input name="category" value="{{item.category}}"></label><div class="formgrid"><label>Precio<input type="number" name="price" value="{{item.price}}"></label><label>Stock<input type="number" name="stock" value="{{item.stock}}"></label></div><label>Formato<input name="size" value="{{item.size}}"></label><label>Imagen (ruta o URL)<input name="image" value="{{item.image}}"></label><label>Video (embed URL)<input name="video" value="{{item.video}}"></label>{% elif key=='clients' %}<label>Email<input name="email" value="{{item.email}}"></label><label>Celular<input name="phone" value="{{item.phone or '095789647'}}"></label><label>Dirección<input name="address" value="{{item.address}}"></label><label>Zona<input name="zone" value="{{item.zone}}"></label>{% elif key=='orders' %}<div class="formgrid"><label>Cliente ID<input name="clientId" value="{{item.clientId}}"></label><label>Total<input name="total" value="{{item.total}}"></label></div><label>Estado<input name="status" value="{{item.status}}"></label><label>Dirección<input name="address" value="{{item.address}}"></label><label>Repartidor ID<input name="delivererId" value="{{item.delivererId}}"></label><label>Franja<input name="slot" value="{{item.slot}}"></label><label>Notas<textarea name="notes">{{item.notes}}</textarea></label>{% elif key=='zones' %}<label>Costo<input name="cost" value="{{item.cost}}"></label><label>Mínimo<input name="minimum" value="{{item.minimum}}"></label><label>Días<input name="days" value="{{item.days}}"></label>{% else %}<label>Email<input name="email" value="{{item.email}}"></label><label>Celular<input name="phone" value="{{item.phone or '095789647'}}"></label><label>Descripción / notas<textarea name="description">{{item.description or item.notes}}</textarea></label><label>Estado<input name="status" value="{{item.status}}"></label><label>Precio<input name="price" value="{{item.price}}"></label><label>Fecha<input name="date" value="{{item.date}}"></label>{% endif %}<label class="check"><input type="checkbox" name="active" {% if item.active or not item.id %}checked{% endif %}> Activo</label>{% if key=='products' %}<label class="check"><input type="checkbox" name="featured" {% if item.featured %}checked{% endif %}> Destacado</label>{% endif %}<button class="btn">Guardar cambios</button></form></main></div>{% endblock %}
