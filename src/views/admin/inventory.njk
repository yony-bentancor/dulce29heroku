{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='CONTROL' %}{% set title='Inventario' %}{% set subtitle='Lectura rápida de stock disponible.' %}{% include 'partials/panel-top.njk' %}<div class="inventory">{% for p in products %}<div><span>{{p.emoji}} {{p.name}}</span><b>{{p.stock}}</b><progress max="30" value="{{p.stock}}"></progress><small>{{'Stock bajo' if p.stock < 10 else 'Disponible'}}</small></div>{% endfor %}</div></section></div>{% endblock %}
