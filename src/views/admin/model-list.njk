{% extends 'base.njk' %}{% block body %}<div class="panel">{% include 'partials/admin-nav.njk' %}<main class="panelmain"><div class="title-row"><div><span class="eyebrow">CRUD COMPLETO</span><h1>{{model.label}}</h1></div><a class="btn" href="/admin/{{key}}/nuevo">+ Crear</a></div><p>Datos demo editables en memoria. Al conectar Mongo esta misma interfaz usará datos persistentes.</p><div class="admincards">{% for x in model.arr %}<article class="admincard">{% if x.image %}<img src="{{x.image}}">{% endif %}<div><h3>{{x.name or ('Pedido #' + x.id)}}</h3>{% for k,v in x %}{% if k not in ['id','image','video','items','description','name'] %}<small><b>{{k}}:</b> {{v}}</small>{% endif %}{% endfor %}{% if x.description %}<p>{{x.description}}</p>{% endif %}</div><div class="row-actions"><a href="/admin/{{key}}/{{x.id}}/editar">Modificar</a><form method="post" action="/admin/{{key}}/{{x.id}}/eliminar" onsubmit="return confirm('¿Eliminar este registro?')"><button class="danger">Eliminar</button></form></div></article>{% else %}<div class="empty">No hay registros. Usá “Crear” para agregar uno.</div>{% endfor %}</div></main></div>{% endblock %}
