{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='OPERACIÓN' %}{% set title='Pedidos' %}{% set subtitle='Control de preparación, reparto y entrega.' %}{% include 'partials/panel-top.njk' %}<div class="admin-list">{% for o in orders %}<div class="order-card"><div><small>#{{o.id}} · {{o.date}}</small><h3>{{o.client}}</h3><p>{{o.items|join(' · ')}}</p><span>{{o.phone}} · {{o.payment}}</span></div><strong>$ {{o.total}}</strong><form action="/admin/pedidos/{{o.id}}/estado" method="post"><select name="status"><option {{'selected' if o.status=='Preparando'}}>Preparando</option><option {{'selected' if o.status=='En reparto'}}>En reparto</option><option {{'selected' if o.status=='Entregado'}}>Entregado</option></select><button>Actualizar</button></form></div>{% endfor %}</div></section></div>{% endblock %}
