{% extends 'base.njk' %}{% block content %}<div class="panel-shell">{% include 'partials/admin-nav.njk' %}<section class="panel-main">{% set eyebrow='CONTENIDO DIGITAL' %}{% set title='Cursos' %}{% set subtitle='Base para cursos, talleres y apartados online.' %}{% include 'partials/panel-top.njk' %}<div class="course-grid admin-courses">{% for c in courses %}<article class="course-card"><div>{{c.emoji}}</div><small>{{c.type}} · {{c.status}}</small><h3>{{c.title}}</h3><p>{{c.students}} alumnos demo</p><footer><b>$ {{c.price}}</b><a href="#">Editar →</a></footer></article>{% endfor %}</div></section></div>{% endblock %}
