{% extends 'base.njk' %}{% block body %}<main class="delivery-mobile"><span class="eyebrow">REPARTIDOR · COLONIA</span><h1>Hola, {{deliverer.name}}</h1><p>Estas son tus entregas asignadas.</p>{% for o in orders %}{% set c=clients|selectattr('id','equalto',o.clientId)|first %}<article class="delivery-card"><div class="status">{{o.status}}</div><h2>#{{o.id}} · {{c.name}}</h2><p>📍 {{o.address}}</p><p>🕐 {{o.slot}} · ${{o.total}}</p><p>📝 {{o.notes or 'Sin observaciones'}}</p><div class="delivery-actions"><a target="_blank" href="https://www.google.com/maps/dir/?api=1&destination={{o.lat}},{{o.lng}}">Cómo llegar</a><a target="_blank" href="https://wa.me/59895789647?text=Hola%20{{c.name|urlencode}},%20soy%20el%20repartidor%20de%20Dulce29.%20Voy%20con%20tu%20pedido%20%23{{o.id}}">WhatsApp</a></div><form method="post" action="/repartidor/pedido/{{o.id}}/estado"><select name="status"><option>Asignado</option><option>En camino</option><option {% if o.status=='Entregado' %}selected{% endif %}>Entregado</option></select><button>Actualizar estado</button></form></article>{% endfor %}</main>{% endblock %}
