{% macro icon(n) %}{% if n == 'bag' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>{% elif n == 'heart' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg>{% elif n == 'menu' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>{% elif n == 'wa' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .3-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.2-1.6-1.2-3s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.4.1.1.1.7-.2 1.3Z"/></svg>{% elif n == 'user' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>{% elif n == 'search' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>{% elif n == 'check' %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{% endif %}{% endmacro %}

{% macro badge(status) %}<span class="pill {{ status|tone }}">{{ status|status }}</span>{% endmacro %}
{% macro leadBadge(status) %}<span class="pill {{ status|tone }}">{{ status|lead }}</span>{% endmacro %}

{% macro field(name, label, value='', type='text', hint='', req=false, attrs='') %}<label class="field"><span>{{ label }}</span><input type="{{ type }}" name="{{ name }}" value="{{ value }}" {% if req %}required{% endif %} {{ attrs|safe }}>{% if hint %}<small>{{ hint }}</small>{% endif %}</label>{% endmacro %}
{% macro area(name, label, value='', hint='', rows=3) %}<label class="field"><span>{{ label }}</span><textarea name="{{ name }}" rows="{{ rows }}">{{ value }}</textarea>{% if hint %}<small>{{ hint }}</small>{% endif %}</label>{% endmacro %}
{% macro select(name, label, options, value='', hint='', empty='') %}<label class="field"><span>{{ label }}</span><select name="{{ name }}">{% if empty %}<option value="">{{ empty }}</option>{% endif %}{% for o in options %}{% set v = o.value if o.value is defined else o %}<option value="{{ v }}" {% if v|string == value|string %}selected{% endif %}>{{ o.label if o.label is defined else o }}</option>{% endfor %}</select>{% if hint %}<small>{{ hint }}</small>{% endif %}</label>{% endmacro %}

{% macro img(src, alt, c='') %}{% if src %}<img src="{{ src }}" alt="{{ alt }}" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'noimg',textContent:'{{ alt|initials }}'}))">{% else %}<div class="noimg">{{ alt|initials }}</div>{% endif %}{% endmacro %}

{% macro timeline(o) %}
{% set steps = ['recibido','preparando','listo','en_camino','entregado'] if o.delivery.method == 'envio' else ['recibido','preparando','listo','entregado'] %}
{% set labels = {'listo': 'Listo para retirar' if o.delivery.method == 'retiro' else 'Listo', 'entregado': 'Retirado' if o.delivery.method == 'retiro' else 'Entregado'} %}
<ol class="timeline{% if o.status == 'cancelado' or o.status == 'no_entregado' %} bad{% endif %}" style="grid-template-columns:repeat({{ steps|length }},1fr)" aria-label="Estado del pedido">
{% for s in steps %}{% set idx = loop.index0 %}{% set cur = steps.indexOf(o.status) %}
{% set h = null %}{% for x in o.history %}{% if x.status == s %}{% set h = x %}{% endif %}{% endfor %}
<li class="{% if cur >= idx or (o.status == 'no_entregado' and idx <= 3) %}done{% endif %}{% if cur == idx %} now{% endif %}">{{ labels[s] or (s|status) }}{% if h %}<small>{{ h.at|time }}</small>{% endif %}</li>
{% endfor %}</ol>
{% if o.status == 'cancelado' or o.status == 'no_entregado' %}<p class="errors" style="padding-left:18px">{{ o.status|status }}{% for x in o.history %}{% if x.status == o.status and x.note %}: {{ x.note }}{% endif %}{% endfor %}</p>{% endif %}
{% endmacro %}

{% macro pager(p, base) %}{% if p.pages > 1 %}<nav class="actions-row" style="margin-top:16px" aria-label="Páginas">{% for n in range(1, p.pages + 1) %}<a class="chip{% if n == p.page %} on{% endif %}" href="{{ base }}{{ '&' if '?' in base else '?' }}page={{ n }}">{{ n }}</a>{% endfor %}</nav>{% endif %}{% endmacro %}
