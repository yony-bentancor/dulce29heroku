{% from 'partials/macros.njk' import icon %}
{% set bnr = null %}{% for b in content.banners %}{% if b.active and not bnr %}{% set bnr = b %}{% endif %}{% endfor %}
{% if bnr %}<div class="promo-bar">{{ bnr.text }}</div>{% endif %}
<header class="site-header"><div class="in">
 <a class="logo" href="/" aria-label="Dulce29, inicio"><img src="/images/brand/logo-dulce29.svg" alt="Dulce29 · Inspirando hábitos" width="174" height="128"></a>
 <nav class="nav" data-nav aria-label="Principal">
  {% set links = [['/productos','Tienda'],['/promociones','Packs'],['/epigenetica','Test epigenético'],['/thermomix','Thermomix'],['/nosotros','Nosotros'],['/contacto','Contacto']] %}
  {% for l in links %}<a href="{{ l[0] }}" {% if currentPath == l[0] or (l[0] == '/productos' and currentPath.startsWith('/producto')) %}aria-current="page"{% endif %}>{{ l[1] }}</a>{% endfor %}
  <div class="nav-account">
   {% if user %}
    <p class="who"><i class="avatar">{{ user.name|initials }}</i><span>{{ user.name }}</span></p>
    <a class="btn block" href="{{ accountHref }}">{{ 'Ir al panel' if user.role == 'admin' else ('Mis entregas' if user.role == 'delivery' else 'Mi cuenta') }}</a>
    <a class="btn ghost block" href="/salir">Cerrar sesión</a>
   {% else %}
    <a class="btn block" href="/ingresar">Ingresar</a>
    <a class="btn ghost block" href="/registrarse">Crear cuenta</a>
    <p class="staff-links"><a href="/admin/ingresar">Administración</a><a href="/repartidor/ingresar">Repartidores</a></p>
   {% endif %}
  </div>
 </nav>
 <div class="actions">
  <a class="account-link" href="{{ accountHref }}">{% if user %}<i class="avatar">{{ user.name|initials }}</i><span>{{ user.name.split(' ')[0] }}</span>{% else %}{{ icon('user') }}<span>Ingresar</span>{% endif %}</a>
  <a class="bag" href="/carrito" data-bag>{{ icon('bag') }}<span>Bolsa</span><b data-bag-count>{{ cartCount }}</b></a>
  <button class="iconbtn menu-btn" data-menu aria-label="Abrir menú" aria-expanded="false">{{ icon('menu') }}</button>
 </div>
</div></header>
