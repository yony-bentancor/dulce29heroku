<article class="product-card"><a class="product-image" href="/producto/{{p.id}}"><img src="{{p.image}}" alt="{{p.name}}" loading="lazy"><span>{{p.category}}</span></a><div class="product-info"><div><h3>{{p.name}}</h3><small>{{p.size}}</small></div><strong>$ {{p.price}}</strong></div><form method="post" action="/carrito/agregar/{{p.id}}"><button class="btn full">Agregar</button></form></article>
