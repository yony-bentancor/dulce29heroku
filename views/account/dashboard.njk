{% extends 'layouts/account.njk' %}{% from 'partials/macros.njk' import timeline, badge, leadBadge %}
{% block title %}Mi cuenta · Dulce29{% endblock %}
{% block account %}
<h1>Hola, {{ c.name.split(' ')[0] }}</h1>
<div class="tiles">
 <a class="tile hl" href="/mi-cuenta/pedidos?estado=activos"><small>Pedidos en curso</small><b>{{ active|length }}</b></a>
 <a class="tile" href="/mi-cuenta/pedidos"><small>Pedidos realizados</small><b>{{ count }}</b></a>
 <div class="tile"><small>Total comprado</small><b>{{ spent|money }}</b></div>
 <a class="tile" href="/mi-cuenta/favoritos"><small>Favoritos</small><b>{{ c.favorites|length }}</b></a>
</div>
{% for o in active %}<div class="panel" style="margin-bottom:16px"><div class="actions-row" style="justify-content:space-between"><h3 style="margin:0">Pedido #{{ o.code }}</h3>{{ badge(o.status) }}</div>{{ timeline(o) }}<div class="actions-row"><a class="btn sm" href="/mi-cuenta/pedidos/{{ o.code }}/seguimiento">Ver seguimiento</a><span class="small muted">{{ 'Retiro' if o.delivery.method == 'retiro' else 'Entrega' }} {{ o.delivery.date|date('long') }}, {{ o.delivery.slot }}</span></div></div>{% endfor %}
<div class="cols-2e">
 <div class="box"><header><h2>Últimos pedidos</h2><a class="link" href="/mi-cuenta/pedidos">Ver todos</a></header><div class="list">{% for o in last %}{% set href = '/mi-cuenta/pedidos/' + o.code %}{% include 'partials/order-row.njk' %}{% else %}<p class="muted">Todavía no hiciste pedidos. <a class="link" href="/productos">Ir a la tienda</a></p>{% endfor %}</div>
  {% if last|length %}<form method="post" action="/mi-cuenta/pedidos/{{ last[0].code }}/repetir" style="margin-top:14px"><button class="btn sm ghost">Repetir mi último pedido</button></form>{% endif %}</div>
 <div class="box"><header><h2>Novedades</h2></header>{% for n in news %}<article style="padding:10px 0;border-bottom:1px solid var(--piedra)"><span class="tiny muted">{{ n.date|date }}</span><br><b>{{ n.title }}</b><p class="small muted" style="margin:0">{{ n.text }}</p></article>{% endfor %}
  {% if inq|length %}<p style="margin-top:14px" class="small">Tenés {{ inq|length }} consulta{{ 's' if inq|length != 1 }}: {% for i in inq %}{{ i.kind|kind }} {{ leadBadge(i.status) }} {% endfor %}<a class="link" href="/mi-cuenta/consultas">ver</a></p>{% endif %}</div>
</div>
{% if favs|length %}<div class="section-head" style="margin:24px 0 18px"><h2 style="font-size:40px">Tus favoritos</h2></div><div class="grid">{% for p in favs %}{% include 'partials/product-card.njk' %}{% endfor %}</div>{% endif %}
<div class="tiles" style="margin-top:28px"><a class="tile" href="/mi-cuenta/direcciones"><small>Direcciones guardadas</small><b>{{ c.addresses|length }}</b></a><a class="tile" href="/epigenetica"><small>Test epigenético</small><b style="font-size:26px">Consultar</b></a><a class="tile" href="/thermomix"><small>Thermomix</small><b style="font-size:26px">Pedir demo</b></a></div>
{% endblock %}
