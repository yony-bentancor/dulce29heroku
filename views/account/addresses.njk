{% extends 'layouts/account.njk' %}{% from 'partials/macros.njk' import field %}
{% block title %}Mis direcciones · Dulce29{% endblock %}
{% block account %}
<h1>Mis direcciones</h1>
<div class="addr" style="margin-bottom:28px">{% for a in c.addresses %}<article><div class="actions-row" style="justify-content:space-between"><b>{{ a.label }}</b>{% if loop.first %}<span class="pill ok">Principal</span>{% endif %}</div><p style="margin:6px 0 2px">{{ a.street }}</p><p class="small muted">{{ a.zone }}{% if a.notes %} · {{ a.notes }}{% endif %}</p>
 <div class="actions-row"><a class="btn sm ghost" href="?editar={{ a.id }}#form">Editar</a><form method="post" action="/mi-cuenta/direcciones/{{ a.id }}/eliminar"><button class="btn sm danger" data-confirm="¿Eliminar {{ a.label }}?">Eliminar</button></form></div></article>{% else %}<div class="empty"><h3>No tenés direcciones guardadas</h3><p>Agregá una para completar el checkout más rápido.</p></div>{% endfor %}</div>
<form class="box" id="form" method="post" action="/mi-cuenta/direcciones" style="max-width:640px"><h2 style="font-size:32px;margin-bottom:14px">{{ 'Editar ' + edit.label if edit else 'Agregar dirección' }}</h2>
 {% if edit %}<input type="hidden" name="id" value="{{ edit.id }}">{% endif %}
 <div class="g2">{{ field('label','Nombre','' + (edit.label if edit else ''),'text','Casa, Trabajo, Mamá…') }}<label class="field"><span>Zona</span><select name="zone" required><option value="">Elegí</option>{% for z in zones %}<option {% if edit and edit.zone == z.name %}selected{% endif %}>{{ z.name }}</option>{% endfor %}</select></label></div>
 {{ field('street','Dirección', edit.street if edit else '','text','',true) }}{{ field('notes','Referencias', edit.notes if edit else '') }}
 <label class="check small" style="margin-bottom:16px"><input type="checkbox" name="main" value="1"> Usar como dirección principal</label>
 <div class="actions-row"><button class="btn">{{ 'Guardar cambios' if edit else 'Agregar dirección' }}</button>{% if edit %}<a class="link" href="/mi-cuenta/direcciones">Cancelar</a>{% endif %}</div>
</form>
{% endblock %}
