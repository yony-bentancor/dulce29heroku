{% extends 'layouts/account.njk' %}{% from 'partials/macros.njk' import badge, timeline %}
{% block title %}Seguimiento #{{ o.code }} · Dulce29{% endblock %}
{% block head %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">{% endblock %}
{% block account %}
<nav class="crumbs"><a href="/mi-cuenta/pedidos">Mis pedidos</a> / <a href="/mi-cuenta/pedidos/{{ o.code }}">#{{ o.code }}</a> / Seguimiento</nav>
<div class="actions-row" style="justify-content:space-between"><h1 style="margin:0">Seguimiento #{{ o.code }}</h1>{{ badge(o.status) }}</div>
{{ timeline(o) }}
<div class="cols-2">
 <div class="box"><header><h2>Historial</h2><span class="tiny muted">Se actualiza solo</span></header><ul class="history">{% for h in o.history|reverse %}<li><time>{{ h.at|datetime }}</time><span><b>{{ h.status|status }}</b> · {{ h.by }}{% if h.note %}<br><span class="muted">{{ h.note }}</span>{% endif %}</span></li>{% endfor %}</ul></div>
 {% if o.delivery.method == 'envio' %}<div class="box"><header><h2>Destino</h2></header><div class="map" style="height:260px" data-map data-points="{{ [{lat:o.delivery.lat,lng:o.delivery.lng,label:o.delivery.street}]|dump }}"></div><p class="small muted" style="margin:10px 0 0">{{ o.delivery.street }} · {{ o.delivery.zone }}</p></div>{% endif %}
</div>
<script>setTimeout(function(){location.reload()},30000)</script>
{% endblock %}
{% block scripts %}<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/mapa.js"></script>{% endblock %}
