{% extends 'layouts/admin.njk' %}
{% block title %}Reportes{% endblock %}{% block heading %}Reportes{% endblock %}
{% block body %}
<form class="filters-bar" method="get"><nav class="seg">{% for x in [['7','7 días'],['30','30 días'],['90','90 días']] %}<a href="?periodo={{ x[0] }}" aria-current="{{ 'true' if p.key == x[0] else 'false' }}">{{ x[1] }}</a>{% endfor %}</nav><span class="small muted">{{ orders }} pedidos analizados · {{ p.from|date }} a {{ p.to|date }}</span></form>
<div class="cols-2">
 <div class="box"><header><h2>Productos más vendidos</h2></header><div class="table-wrap" style="border:0"><table class="t"><thead><tr><th>#</th><th>Producto</th><th class="r">Unidades</th><th class="r">Ingresos</th><th style="width:30%"></th></tr></thead><tbody>{% for t in top %}<tr><td>{{ loop.index }}</td><td>{{ t.k }}</td><td class="r">{{ t.qty }}</td><td class="r num">{{ t.total|money }}</td><td><div class="stockbar" style="width:100%"><i style="width:{{ t.total|pct(top[0].total) }}%;background:var(--esmeralda)"></i></div></td></tr>{% endfor %}</tbody></table></div></div>
 <div class="box"><header><h2>Por categoría</h2></header><div class="bars">{% for c in cats %}<div><span>{{ c.k }}</span><i style="width:{{ c.v|pct(cats[0].v) }}%;min-width:4px"></i><span>{{ c.v|money }}</span></div>{% endfor %}</div></div>
</div>
<div class="cols-2">
 <div class="box"><header><h2>Clientes recurrentes</h2><span class="small muted">{{ (repeatRate*100)|round }}% de los clientes del período repitió</span></header><div class="table-wrap" style="border:0"><table class="t"><thead><tr><th>Cliente</th><th class="r">Pedidos</th><th class="r">Gasto</th></tr></thead><tbody>{% for r in recurring %}<tr class="click" data-href="/admin/clientes/{{ r.c.id }}"><td><a href="/admin/clientes/{{ r.c.id }}">{{ r.c.name }}</a></td><td class="r">{{ r.n }}</td><td class="r num">{{ r.total|money }}</td></tr>{% endfor %}</tbody></table></div></div>
 <div>
  <div class="box"><header><h2>Pedidos por zona</h2></header><div class="bars">{% for z in zones %}<div><span>{{ z.k }}</span><i style="width:{{ z.v|pct(zones[0].v) }}%;min-width:4px"></i><span>{{ z.v }}</span></div>{% endfor %}</div></div>
  <div class="box"><header><h2>Día de la semana</h2></header>{% set mx = 1 %}{% for d in dow %}{% if d.v > mx %}{% set mx = d.v %}{% endif %}{% endfor %}<div class="bars">{% for d in dow %}<div><span>{{ d.k }}</span><i style="width:{{ d.v|pct(mx) }}%;min-width:4px"></i><span>{{ d.v }}</span></div>{% endfor %}</div></div>
  <div class="box"><header><h2>Horario de entrega elegido</h2></header>{% set ms = 1 %}{% for d in slots %}{% if d.v > ms %}{% set ms = d.v %}{% endif %}{% endfor %}<div class="bars">{% for d in slots %}<div><span>{{ d.k }}</span><i style="width:{{ d.v|pct(ms) }}%;min-width:4px"></i><span>{{ d.v }}</span></div>{% endfor %}</div></div>
 </div>
</div>
{% endblock %}
