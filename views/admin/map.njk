{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import badge %}
{% block title %}Mapa de entregas{% endblock %}{% block heading %}Mapa de entregas{% endblock %}
{% block head %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">{% endblock %}
{% block body %}
<form class="filters-bar" method="get"><input class="input" type="date" name="dia" value="{{ date }}"><select class="input" name="repartidor"><option value="">Todos los repartidores</option><option value="0" {% if rid == '0' %}selected{% endif %}>Sin asignar</option>{% for r in riders %}<option value="{{ r.id }}" {% if rid == r.id|string %}selected{% endif %}>{{ r.name }}</option>{% endfor %}</select><button class="btn sm">Ver</button>
 <span class="small" style="margin-left:auto;display:flex;gap:12px;flex-wrap:wrap">{% for r in riders %}<span><span class="dot" style="background:{{ colors[(r.id-1) % 4 + 1] or colors[1] }}"></span> {{ r.name.split(' ')[0] }}</span>{% endfor %}<span><span class="dot" style="background:#8A958E"></span> Sin asignar</span><span><span class="dot" style="background:#1F8A55"></span> Entregado</span></span></form>
<div class="cols-2"><div class="map tall" data-map data-points="{{ points|dump }}"></div>
 <div class="box" style="max-height:calc(100vh - 220px);overflow:auto"><header><h2>{{ os|length }} entregas</h2></header>{% for o in os %}<a class="kcard" href="/admin/pedidos/{{ o.id }}"><span class="seq">{{ loop.index }}</span><b>#{{ o.code }}</b> {{ badge(o.status) }}<br>{{ o.delivery.street }} · {{ o.delivery.zone }}<br><span class="tiny muted">{{ o.delivery.slot }} · {{ o.deliverer.name if o.deliverer else 'Sin repartidor' }}</span></a>{% else %}<p class="muted">No hay entregas ese día.</p>{% endfor %}</div></div>
{% endblock %}
{% block scripts %}<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/mapa.js"></script>{% endblock %}
