{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import badge, leadBadge, field, icon %}
{% block title %}{{ c.name }}{% endblock %}{% block heading %}{{ c.name }}{% endblock %}
{% block actions %}<a class="btn sm wa" href="{{ wa }}" target="_blank" rel="noopener">{{ icon('wa') }} WhatsApp</a><a class="btn sm" href="/admin/pedidos/nuevo?cliente={{ c.id }}">Nuevo pedido</a>{% endblock %}
{% block body %}
<div class="kpis"><div class="kpi"><small>Pedidos</small><b>{{ st.orders }}</b></div><div class="kpi"><small>Gasto acumulado (entregado)</small><b>{{ st.spent|money }}</b></div><div class="kpi"><small>Ticket promedio</small><b>{{ ticket|money }}</b></div><div class="kpi"><small>Cliente desde</small><b style="font-size:28px">{{ c.createdAt|date('full') }}</b><em>{{ 'Con cuenta: ' + account.email if account else 'Compra como invitado' }}</em></div></div>
<div class="cols-2">
 <div>
  <div class="box"><header><h2>Pedidos</h2></header><div class="table-wrap" style="border:0"><table class="t cards"><thead><tr><th>Pedido</th><th>Fecha</th><th>Productos</th><th class="r">Total</th><th>Estado</th></tr></thead><tbody>
  {% for o in os %}<tr class="click" data-href="/admin/pedidos/{{ o.id }}"><td><a href="/admin/pedidos/{{ o.id }}"><b>#{{ o.code }}</b></a></td><td class="nw small">{{ o.createdAt|date('full') }}</td><td class="small">{% for i in o.items %}{{ i.qty }} {{ i.name }}{{ ', ' if not loop.last }}{% endfor %}</td><td class="r num">{{ o.total|money }}</td><td>{{ badge(o.status) }}</td></tr>{% else %}<tr><td colspan="5" class="muted">Sin pedidos.</td></tr>{% endfor %}</tbody></table></div></div>
  {% if top|length %}<div class="box"><header><h2>Lo que más pide</h2></header><div class="bars">{% for t in top %}<div><span>{{ t[0] }}</span><i style="width:{{ t[1]|pct(top[0][1]) }}%"></i><span>{{ t[1] }} u.</span></div>{% endfor %}</div></div>{% endif %}
 </div>
 <div>
  <form class="box" method="post" action="/admin/clientes"><header><h2>Datos y notas</h2></header><input type="hidden" name="id" value="{{ c.id }}">
   {{ field('name','Nombre',c.name,'text','',true) }}<div class="g2">{{ field('phone','Teléfono',c.phone,'tel','',true) }}{{ field('email','Email',c.email,'email') }}</div>
   <label class="field"><span>Notas internas</span><textarea name="notes" rows="3">{{ c.notes }}</textarea><small>Alergias, preferencias, horarios. Las ve el equipo en cada pedido.</small></label>
   <details style="margin-bottom:14px"><summary class="link" style="cursor:pointer">Agregar dirección</summary><div style="padding-top:12px">{{ field('label','Nombre','Casa') }}{{ field('street','Dirección') }}<label class="field"><span>Zona</span><select name="zone"><option value="">—</option>{% for z in zones %}<option>{{ z.name }}</option>{% endfor %}</select></label></div></details>
   <button class="btn sm">Guardar</button></form>
  <div class="box"><header><h2>Direcciones</h2></header>{% for a in c.addresses %}<p style="margin:0 0 10px"><b>{{ a.label }}</b> · {{ a.street }}<br><span class="small muted">{{ a.zone }}{% if a.notes %} · {{ a.notes }}{% endif %}</span></p>{% else %}<p class="muted">Sin direcciones.</p>{% endfor %}</div>
  {% if favs|length %}<div class="box"><header><h2>Favoritos</h2></header><p class="small" style="margin:0">{% for p in favs %}{{ p.name }}{{ ', ' if not loop.last }}{% endfor %}</p></div>{% endif %}
  {% if inq|length %}<div class="box"><header><h2>Consultas</h2></header>{% for i in inq %}<p class="small" style="margin:0 0 8px">{{ i.kind|kind }} {{ leadBadge(i.status) }}<br><span class="muted">{{ i.message }}</span></p>{% endfor %}</div>{% endif %}
 </div>
</div>
{% endblock %}
