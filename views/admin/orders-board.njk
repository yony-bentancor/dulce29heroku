{% extends 'layouts/admin.njk' %}
{% block title %}Tablero de pedidos{% endblock %}{% block heading %}Tablero{% endblock %}
{% block actions %}<a class="btn sm ghost" href="/admin/pedidos">Vista de lista</a><a class="btn sm" href="/admin/pedidos/nuevo">Nuevo pedido</a>{% endblock %}
{% block body %}
<p class="small muted" style="margin-top:0">Avanzá cada pedido al siguiente estado con un clic. La página se actualiza sola cada 30 segundos.</p>
<div class="kanban">{% for col in cols %}<section aria-label="{{ col.s|status }}"><h3>{{ col.s|status }} <span class="muted">{{ col.items|length }}</span></h3>
{% for o in col.items %}<div class="kcard"><a href="/admin/pedidos/{{ o.id }}" style="text-decoration:none"><b>#{{ o.code }}</b> <span class="tiny muted">{{ o.createdAt|ago }}</span><br>{{ o.customer.name }}<br><span class="tiny muted">{{ 'Retiro' if o.delivery.method == 'retiro' else o.delivery.zone }} · {{ o.delivery.slot }} · {{ o.total|money }}</span></a>
 {% set nx = {'recibido':'preparando','preparando':'listo','listo':('entregado' if o.delivery.method == 'retiro' else 'en_camino'),'en_camino':'entregado'}[o.status] %}
 <form method="post" action="/admin/pedidos/{{ o.id }}/estado" style="margin-top:8px"><input type="hidden" name="status" value="{{ nx }}"><button class="btn sm block ghost">Pasar a {{ nx|status|lower }}</button></form></div>{% else %}<p class="tiny muted" style="padding:6px">Nada por acá.</p>{% endfor %}</section>{% endfor %}</div>
<script>setTimeout(()=>location.reload(),30000)</script>
{% endblock %}
