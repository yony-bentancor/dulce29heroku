{% extends 'layouts/admin.njk' %}
{% block title %}Stock{% endblock %}{% block heading %}Stock e inventario{% endblock %}
{% block body %}
<div class="kpis"><div class="kpi"><small>Valor del stock (a precio de venta)</small><b>{{ value|money }}</b></div><a class="kpi alert" href="?filtro=bajo"><small>Para reponer</small><b>{{ nav.stock }}</b></a></div>
<nav class="seg" style="margin-bottom:14px"><a href="?filtro=todos" aria-current="{{ 'true' if f == 'todos' else 'false' }}">Todos</a><a href="?filtro=bajo" aria-current="{{ 'true' if f == 'bajo' else 'false' }}">Bajo el mínimo</a></nav>
<div class="table-wrap"><table class="t cards"><thead><tr><th>Producto</th><th class="r">Stock</th><th class="r">Mínimo</th><th class="r">En pedidos abiertos</th><th class="r">Vendidos 30 d</th><th>Alcanza para</th><th>Ajustar</th></tr></thead><tbody>
{% for p in products %}<tr><td><b>{{ p.name }}</b><br><span class="tiny muted">{{ p.category }}</span></td>
 <td class="r"><span class="pill {{ 'bad' if p.stock <= 0 else ('warn' if p.stock <= p.minStock else 'ok') }}">{{ p.stock }}</span></td><td class="r">{{ p.minStock }}</td><td class="r">{{ reserved[p.id] or 0 }}</td><td class="r">{{ p.sold }}</td>
 <td class="small">{% if p.days === null %}<span class="muted">sin ventas</span>{% elif p.days <= 3 %}<b style="color:var(--bad)">{{ p.days }} días</b>{% else %}{{ p.days }} días{% endif %}</td>
 <td><form class="actions-row" method="post" action="/admin/stock/{{ p.id }}" style="flex-wrap:nowrap"><select class="input" name="mode" style="min-height:34px;width:auto;padding:4px 8px"><option value="in">+ Producción</option><option value="out">− Merma</option><option value="set">= Conteo</option></select><input class="input" type="number" name="amount" min="0" required style="min-height:34px;width:80px" aria-label="Cantidad"><button class="btn sm">Aplicar</button></form></td></tr>{% endfor %}
</tbody></table></div>
<div class="box" style="margin-top:16px"><header><h2>Movimientos recientes</h2></header>{% if log|length %}<div class="table-wrap" style="border:0"><table class="t cards"><thead><tr><th>Fecha</th><th>Producto</th><th class="r">Cambio</th><th>Motivo</th><th>Quién</th></tr></thead><tbody>{% for l in log %}<tr><td class="nw">{{ l.at|datetime }}</td><td>{{ l.name }}</td><td class="r num" style="color:{{ 'var(--ok)' if l.delta > 0 else 'var(--bad)' }}">{{ '+' if l.delta > 0 }}{{ l.delta }}</td><td>{{ l.reason }}</td><td>{{ l.by }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="muted">Todavía no hay movimientos manuales. Los pedidos descuentan stock automáticamente.</p>{% endif %}</div>
{% endblock %}
