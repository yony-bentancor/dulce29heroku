{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import badge, pager %}
{% block title %}Pedidos{% endblock %}{% block heading %}Pedidos{% endblock %}
{% block actions %}<a class="btn sm ghost" href="/admin/pedidos?vista=tablero">Tablero</a><a class="btn sm ghost" href="/admin/pedidos/exportar.csv?{{ qs }}&estado={{ q.estado }}">Exportar CSV</a><a class="btn sm" href="/admin/pedidos/nuevo">Nuevo pedido</a>{% endblock %}
{% block body %}
<nav class="seg" style="margin-bottom:14px" aria-label="Estados">{% set st = q.estado or 'todos' %}
 <a href="?{{ qs }}" aria-current="{{ 'true' if st == 'todos' else 'false' }}">Todos</a>
 <a href="?estado=abiertos&{{ qs }}" aria-current="{{ 'true' if st == 'abiertos' else 'false' }}">En curso<small>{{ counts.abiertos }}</small></a>
 {% for s in ['recibido','preparando','listo','en_camino','entregado','no_entregado','cancelado'] %}<a href="?estado={{ s }}&{{ qs }}" aria-current="{{ 'true' if st == s else 'false' }}">{{ s|status }}<small>{{ counts[s] }}</small></a>{% endfor %}</nav>
<form class="filters-bar" method="get">{% if q.estado %}<input type="hidden" name="estado" value="{{ q.estado }}">{% endif %}
 <input class="input" type="search" name="q" value="{{ q.q }}" placeholder="Número, nombre o teléfono" style="min-width:240px">
 <select class="input" name="fecha"><option value="">Cualquier día de entrega</option>{% for x in [['hoy','Entrega hoy'],['manana','Entrega mañana'],['semana','Últimos 7 días']] %}<option value="{{ x[0] }}" {% if q.fecha == x[0] %}selected{% endif %}>{{ x[1] }}</option>{% endfor %}</select>
 <select class="input" name="pago"><option value="">Pagado y pendiente</option><option value="pendiente" {% if q.pago == 'pendiente' %}selected{% endif %}>Pago pendiente</option><option value="pagado" {% if q.pago == 'pagado' %}selected{% endif %}>Pagado</option></select>
 <select class="input" name="entrega"><option value="">Envío y retiro</option><option value="envio" {% if q.entrega == 'envio' %}selected{% endif %}>Envío</option><option value="retiro" {% if q.entrega == 'retiro' %}selected{% endif %}>Retiro</option></select>
 <button class="btn sm">Filtrar</button>{% if qs %}<a class="link small" href="/admin/pedidos">Limpiar</a>{% endif %}
 <span class="small muted" style="margin-left:auto">{{ total }} pedidos · {{ sum|money }}</span></form>
<div class="table-wrap"><table class="t"><thead><tr><th>Pedido</th><th>Cliente</th><th>Entrega</th><th>Repartidor</th><th>Pago</th><th class="r">Total</th><th>Estado</th></tr></thead><tbody>
{% for o in orders %}<tr class="click{% if o.isNew %} isnew{% endif %}" data-href="/admin/pedidos/{{ o.id }}">
 <td class="nw"><a href="/admin/pedidos/{{ o.id }}"><b>#{{ o.code }}</b></a>{% if o.isNew %} <span class="pill go">Nuevo</span>{% endif %}<br><span class="tiny muted">{{ o.createdAt|datetime }} · {{ o.channel }}</span></td>
 <td>{{ o.customer.name }}<br><span class="tiny muted">{{ o.customer.phone }}</span></td>
 <td class="nw">{{ 'Retiro en local' if o.delivery.method == 'retiro' else o.delivery.zone }}<br><span class="tiny muted">{{ o.delivery.date|date }} · {{ o.delivery.slot }}</span></td>
 <td>{{ o.deliverer.name if o.deliverer else ('—' if o.delivery.method == 'retiro' else 'Sin asignar') }}</td>
 <td class="nw">{{ o.payment.method }}<br><span class="pill {{ 'ok' if o.payment.status == 'pagado' else 'warn' }}">{{ 'Pagado' if o.payment.status == 'pagado' else 'Pendiente' }}</span></td>
 <td class="r num"><b>{{ o.total|money }}</b><br><span class="tiny muted">{{ o.qty }} u.</span></td><td>{{ badge(o.status) }}</td></tr>
{% else %}<tr><td colspan="7"><div class="empty" style="border:0">No hay pedidos con esos filtros.</div></td></tr>{% endfor %}</tbody></table></div>
{{ pager(pager, '/admin/pedidos?' + qs + ('&estado=' + q.estado if q.estado else '')) }}
{% endblock %}
