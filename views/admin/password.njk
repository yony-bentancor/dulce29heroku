{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import field %}
{% block title %}Cambiar mi contraseña{% endblock %}{% block heading %}Cambiar mi contraseña{% endblock %}
{% block body %}
<div class="box" style="max-width:480px"><header><h2>{{ user.name }}</h2><span class="small muted">{{ user.email }}</span></header>
 {% if errors %}<ul class="errors">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
 <form method="post">
  {{ field('current','Contraseña actual','','password','',true,'autocomplete="current-password"') }}
  {{ field('newpass','Contraseña nueva','','password','Mínimo 6 caracteres.',true,'autocomplete="new-password" minlength="6"') }}
  {{ field('newpass2','Repetí la contraseña nueva','','password','',true,'autocomplete="new-password" minlength="6"') }}
  <button class="btn">Guardar contraseña</button>
 </form>
</div>
{% endblock %}
