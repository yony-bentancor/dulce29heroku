{% extends 'layouts/admin.njk' %}
{% block title %}Ventas{% endblock %}{% block heading %}Ventas y economía{% endblock %}
{% block actions %}<a class="btn sm ghost" href="/admin/pedidos/exportar.csv">Exportar pedidos</a>{% endblock %}
{% block body %}
<form class="filters-bar" method="get"><nav class="seg">{% for x in [['7','7 días'],['30','30 días'],['90','90 días']] %}<a href="?periodo={{ x[0] }}" aria-current="{{ 'true' if p.key == x[0] else 'false' }}">{{ x[1] }}</a>{% endfor %}</nav>
 <span class="small muted">o desde</span><input class="input" type="date" name="desde" value="{{ p.from }}"><span class="small muted">hasta</span><input class="input" type="date" name="hasta" value="{{ p.to }}"><button class="btn sm">Aplicar</button></form>
{% set diff = ((k.total - k.prevTotal) / k.prevTotal * 100)|round if k.prevTotal else 0 %}
<div class="kpis">
 <div class="kpi"><small>Ingresos del período</small><b>{{ k.total|money }}</b><em class="{{ 'up' if diff >= 0 else 'down' }}">{{ '+' if diff >= 0 }}{{ diff }}% vs. período anterior</em></div>
 <div class="kpi"><small>Pedidos</small><b>{{ k.orders }}</b><em>{{ k.cancelled }} cancelados</em></div>
 <div class="kpi"><small>Ticket promedio</small><b>{{ k.ticket|money }}</b></div>
 <div class="kpi"><small>Cobrado por envíos</small><b>{{ k.shipping|money }}</b></div>
 <div class="kpi{% if k.pending %} alert{% endif %}"><small>Pendiente de cobro</small><b>{{ k.pending|money }}</b></div>
</div>
<div class="box"><header><h2>Ingresos por día</h2><span class="small muted">{{ p.from|date('full') }} – {{ p.to|date('full') }}</span></header>{{ chart|safe }}</div>
<div class="cols-2e">
 {% for g in [['Formas de pago', byPay], ['Canal', byChannel], ['Entrega', byMethod], ['Cobranza', byPaid]] %}
 <div class="box"><header><h2>{{ g[0] }}</h2></header><div class="bars">{% for r in g[1] %}<div><span>{{ r.k }}<br><span class="tiny muted">{{ r.n }} pedidos</span></span><i style="width:{{ r.total|pct(total) }}%;min-width:4px"></i><span>{{ r.total|money }}<br><span class="tiny muted">{{ r.total|pct(total) }}%</span></span></div>{% else %}<p class="muted">Sin datos.</p>{% endfor %}</div></div>{% endfor %}
</div>
{% endblock %}
