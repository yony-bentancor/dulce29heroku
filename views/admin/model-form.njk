{% extends 'layouts/base.njk' %}{% block content %}<section class="admin-page form-page"><a href="/admin/{{key}}">← {{label}}</a><h1>{{'Editar' if item.id else 'Nuevo'}} {{label|lower}}</h1><form class="admin-form" method="post" action="/admin/{{key}}/guardar">{% if item.id %}<input type="hidden" name="id" value="{{item.id}}">{% endif %}
<label>Nombre<input name="name" value="{{item.name or ''}}"></label><label>Estado<input name="status" value="{{item.status or ''}}"></label><label>Categoría<input name="category" value="{{item.category or ''}}"></label><label>Email<input name="email" value="{{item.email or ''}}"></label><label>Teléfono<input name="phone" value="{{item.phone or ''}}"></label><label>Precio<input type="number" name="price" value="{{item.price or ''}}"></label><label>Stock<input type="number" name="stock" value="{{item.stock or ''}}"></label><label>Total<input type="number" name="total" value="{{item.total or ''}}"></label><label>Imagen / URL<input name="image" value="{{item.image or ''}}"></label><label class="wide">Descripción<textarea name="description">{{item.description or ''}}</textarea></label><label class="check"><input type="checkbox" name="active" {{'checked' if item.active}}> Activo</label><label class="check"><input type="checkbox" name="featured" {{'checked' if item.featured}}> Destacado</label><label class="check"><input type="checkbox" name="paid" {{'checked' if item.paid}}> Cobrado</label><button class="btn dark">Guardar cambios</button></form></section>{% endblock %}
