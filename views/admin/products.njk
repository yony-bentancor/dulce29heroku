{% extends 'layouts/admin.njk' %}
{% block title %}Productos{% endblock %}{% block heading %}Productos{% endblock %}
{% block actions %}<a class="btn sm ghost" href="/admin/categorias">Categorías</a><a class="btn sm" href="/admin/productos/nuevo">Nuevo producto</a>{% endblock %}
{% block body %}
<form class="filters-bar" method="get"><input class="input" type="search" name="q" value="{{ q.q }}" placeholder="Buscar producto">
 <select class="input" name="categoria"><option value="">Todas las categorías</option>{% for c in categories %}<option value="{{ c.id }}" {% if q.categoria == c.id|string %}selected{% endif %}>{{ c.name }}</option>{% endfor %}</select>
 <select class="input" name="estado"><option value="">Todos</option>{% for x in [['activos','Visibles'],['ocultos','Ocultos'],['sinstock','Sin stock']] %}<option value="{{ x[0] }}" {% if q.estado == x[0] %}selected{% endif %}>{{ x[1] }}</option>{% endfor %}</select>
 <button class="btn sm">Filtrar</button><span class="small muted" style="margin-left:auto">{{ products|length }} productos</span></form>
<div class="table-wrap"><table class="t"><thead><tr><th></th><th>Producto</th><th>Categoría</th><th class="r">Precio</th><th>Stock</th><th class="r">Vendidos 30 d</th><th>Visible</th><th>Destacado</th><th></th></tr></thead><tbody>
{% for p in products %}<tr>
 <td><img class="thumb" src="{{ p.image }}" alt="" onerror="this.style.visibility='hidden'"></td>
 <td><a href="/admin/productos/{{ p.id }}/editar"><b>{{ p.name }}</b></a><br><span class="tiny muted">{{ p.size }} · /producto/{{ p.slug }}</span></td><td>{{ p.category }}</td>
 <td class="r num">{{ p.price|money }}{% if p.compareAt %}<br><s class="tiny muted">{{ p.compareAt|money }}</s>{% endif %}</td>
 <td class="nw"><span class="stockbar {{ 'out' if p.stock <= 0 else ('low' if p.stock <= p.minStock) }}" style="display:inline-block;vertical-align:middle"><i style="width:{{ p.stock|pct(p.minStock*3) }}%"></i></span> {{ p.stock }}</td>
 <td class="r">{{ p.sold }}</td>
 <td><form method="post" action="/admin/productos/{{ p.id }}/alternar"><input type="hidden" name="field" value="active"><button class="pill {{ 'ok' if p.active else 'bad' }}" style="border:0;cursor:pointer">{{ 'Visible' if p.active else 'Oculto' }}</button></form></td>
 <td><form method="post" action="/admin/productos/{{ p.id }}/alternar"><input type="hidden" name="field" value="featured"><button class="pill {{ 'dark' if p.featured }}" style="border:0;cursor:pointer">{{ 'Sí' if p.featured else 'No' }}</button></form></td>
 <td class="nw"><a class="btn sm ghost" href="/admin/productos/{{ p.id }}/editar">Editar</a></td></tr>
{% else %}<tr><td colspan="9"><div class="empty" style="border:0">No hay productos con esos filtros.</div></td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
