{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import badge %}
{% block title %}Entregas{% endblock %}{% block heading %}Entregas{% endblock %}
{% block actions %}<a class="btn sm ghost" href="/admin/mapa?dia={{ date }}">Ver en el mapa</a>{% endblock %}
{% block body %}
<nav class="seg" style="margin-bottom:16px">{% for d in days %}<a href="?dia={{ d.d }}" aria-current="{{ 'true' if d.d == date else 'false' }}">{{ d.label }}<small>{{ d.n }}</small></a>{% endfor %}</nav>
{% if unassigned|length %}<form class="box" method="post" action="/admin/pedidos/asignar"><header><h2>Sin repartidor ({{ unassigned|length }})</h2>
 <span class="actions-row"><select class="input" name="delivererId" required style="min-height:38px;width:auto"><option value="">Asignar seleccionados a…</option>{% for r in riders %}<option value="{{ r.id }}">{{ r.name }}</option>{% endfor %}</select><button class="btn sm">Asignar</button></span></header>
 <div class="table-wrap" style="border:0"><table class="t cards"><thead><tr><th><input type="checkbox" onclick="this.closest('table').querySelectorAll('[name=ids]').forEach(c=>c.checked=this.checked)" aria-label="Seleccionar todos"></th><th>Pedido</th><th>Horario</th><th>Zona</th><th>Dirección</th><th>Sugerido</th><th>Estado</th></tr></thead><tbody>
 {% for o in unassigned %}<tr><td><input type="checkbox" name="ids" value="{{ o.id }}" checked aria-label="Seleccionar #{{ o.code }}"></td><td><a href="/admin/pedidos/{{ o.id }}"><b>#{{ o.code }}</b></a> {{ o.customer.name }}</td><td>{{ o.delivery.slot }}</td><td>{{ o.delivery.zone }}</td><td class="small">{{ o.delivery.street }}</td><td class="small">{% for r in riders %}{% if o.delivery.zone in r.zones %}{{ r.name.split(' ')[0] }} {% endif %}{% endfor %}</td><td>{{ badge(o.status) }}</td></tr>{% endfor %}</tbody></table></div></form>{% endif %}
<div class="cols-2e">{% for g in byRider %}<div class="box"><header><h2>{{ g.r.name }}</h2><span class="small muted">{{ g.r.vehicle }} · {{ g.items|length }} entregas</span></header>
 {% for o in g.items %}<div class="actions-row" style="justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--piedra);flex-wrap:nowrap"><span><span class="seq">{{ loop.index }}</span><a href="/admin/pedidos/{{ o.id }}"><b>#{{ o.code }}</b></a> {{ o.delivery.slot }}<br><span class="small muted" style="margin-left:40px">{{ o.delivery.street }} · {{ o.delivery.zone }}</span></span><span>{{ badge(o.status) }}</span></div>{% else %}<p class="muted">Sin entregas asignadas este día.</p>{% endfor %}</div>{% endfor %}</div>
{% if pickups|length %}<div class="box"><header><h2>Retiros en el local</h2></header>{% for o in pickups %}<div class="actions-row" style="justify-content:space-between;padding:6px 0"><span><a href="/admin/pedidos/{{ o.id }}"><b>#{{ o.code }}</b></a> {{ o.customer.name }} · {{ o.delivery.slot }}</span>{{ badge(o.status) }}</div>{% endfor %}</div>{% endif %}
{% if not os|length and not pickups|length %}<div class="empty">No hay entregas para este día.</div>{% endif %}
{% endblock %}
