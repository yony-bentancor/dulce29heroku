{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import field, area %}
{% block title %}Contenido web{% endblock %}{% block heading %}Contenido web{% endblock %}
{% set pages = {'inicio': ['Inicio', '/'], 'nosotros': ['Nosotros', '/nosotros'], 'faq': ['Preguntas frecuentes', '/preguntas-frecuentes'], 'servicios': ['Epigenética y Thermomix', '/epigenetica'], 'legales': ['Términos y privacidad', '/terminos'], 'novedades': ['Novedades', '/'] } %}
{% block actions %}<a class="btn sm ghost" href="{{ pages[tab][1] }}" target="_blank">Ver en la web</a>{% endblock %}
{% block body %}
<nav class="seg" style="margin-bottom:18px" aria-label="Páginas">{% for k, v in pages %}<a href="/admin/contenido/{{ k }}" aria-current="{{ 'true' if tab == k else 'false' }}">{{ v[0] }}</a>{% endfor %}</nav>
<form method="post" action="/admin/contenido/{{ tab }}">

{% if tab == 'inicio' %}
 <div class="cols-2e">
  <div class="box"><header><h2>Portada</h2></header>
   {{ field('hero[title]','Título principal',c.hero.title,'text','',true) }}
   {{ area('hero[text]','Texto',c.hero.text,'',3) }}
   {{ field('hero[cta]','Texto del botón',c.hero.cta) }}</div>
  <div class="box"><header><h2>Avisos de la barra superior</h2><button type="button" class="btn sm ghost" data-addrow-to="banners">Agregar aviso</button></header>
   <div id="banners" data-rows class="list">{% for b in c.banners %}<div class="actions-row" data-row style="flex-wrap:nowrap"><input class="input" name="banners[{{ loop.index0 }}][text]" value="{{ b.text }}" aria-label="Texto del aviso" style="flex:1"><label class="check small"><input type="checkbox" name="banners[{{ loop.index0 }}][active]" value="1" {% if b.active %}checked{% endif %}> Visible</label><button type="button" class="btn sm ghost" data-delrow>Quitar</button></div>{% endfor %}</div></div>
 </div>
 <div class="box"><header><h2>Sabores de la botella 3D</h2><span class="small muted">Cada bloque del inicio cambia el color del líquido y del fondo</span></header>
  <div class="g3">{% for f in c.flavors %}<fieldset style="border:1px solid var(--linea);border-radius:12px;padding:14px 14px 4px;margin:0">
   <legend style="padding:0 6px;font-weight:700"><span class="dot" style="background:{{ f.liquid }}"></span> {{ f.name }}</legend>
   {{ field('flavors[' ~ loop.index0 ~ '][name]','Nombre del sabor',f.name,'text','Se ve en los botones junto a la botella y en «Agregar … a la bolsa».',true,'maxlength="18"') }}
   {{ field('flavors[' ~ loop.index0 ~ '][title]','Título',f.title) }}
   {{ area('flavors[' ~ loop.index0 ~ '][text]','Texto',f.text,'',3) }}
   <div class="g3">{{ field('flavors[' ~ loop.index0 ~ '][liquid]','Líquido',f.liquid,'color') }}{{ field('flavors[' ~ loop.index0 ~ '][bg]','Fondo',f.bg,'color') }}{{ field('flavors[' ~ loop.index0 ~ '][accent]','Texto',f.accent,'color') }}</div>
   <label class="field"><span>Producto que abre</span><select name="flavors[{{ loop.index0 }}][productId]">{% for p in productsList %}<option value="{{ p.id }}" {% if p.id == f.productId %}selected{% endif %}>{{ p.name }}</option>{% endfor %}</select></label>
  </fieldset>{% endfor %}</div></div>
 <div class="box"><header><h2>Cómo funciona</h2><button type="button" class="btn sm ghost" data-addrow-to="steps">Agregar paso</button></header>
  <div id="steps" data-rows class="list">{% for s in c.steps %}<div class="actions-row" data-row style="flex-wrap:nowrap"><input class="input" name="steps[{{ loop.index0 }}][title]" value="{{ s.title }}" aria-label="Paso" style="width:180px"><input class="input" name="steps[{{ loop.index0 }}][text]" value="{{ s.text }}" aria-label="Descripción" style="flex:1"><button type="button" class="btn sm ghost" data-delrow>Quitar</button></div>{% endfor %}</div></div>

{% elif tab == 'nosotros' %}
 <div class="form-grid">
  <div class="box">{{ field('title','Título',c.about.title,'text','',true) }}{{ area('text','Bajada',c.about.text,'',2) }}
   {{ area('story','Historia',c.about.story|join('\n\n'),'Separá los párrafos con una línea en blanco.',10) }}</div>
  <div class="box"><header><h2>Valores</h2><button type="button" class="btn sm ghost" data-addrow-to="values">Agregar</button></header>
   <div id="values" data-rows class="list">{% for v in c.about.values %}<div data-row style="border-bottom:1px solid var(--linea);padding-bottom:10px"><input class="input" name="values[{{ loop.index0 }}][title]" value="{{ v.title }}" aria-label="Valor" style="margin-bottom:6px"><textarea class="input" name="values[{{ loop.index0 }}][text]" rows="2" aria-label="Descripción">{{ v.text }}</textarea><button type="button" class="btn sm ghost" data-delrow style="margin-top:6px">Quitar</button></div>{% endfor %}</div></div>
 </div>

{% elif tab == 'faq' %}
 <div class="box"><header><h2>Preguntas frecuentes</h2><button type="button" class="btn sm ghost" data-addrow-to="faq">Agregar pregunta</button></header>
  <div id="faq" data-rows class="list">{% for q in c.faq %}<div data-row class="g3" style="grid-template-columns:2fr 3fr 140px auto;align-items:start;gap:8px;border-bottom:1px solid var(--linea);padding-bottom:10px">
   <textarea class="input" name="faq[{{ loop.index0 }}][q]" rows="3" aria-label="Pregunta">{{ q.q }}</textarea><textarea class="input" name="faq[{{ loop.index0 }}][a]" rows="3" aria-label="Respuesta">{{ q.a }}</textarea>
   <input class="input" name="faq[{{ loop.index0 }}][topic]" value="{{ q.topic }}" aria-label="Tema" list="topics"><button type="button" class="btn sm ghost" data-delrow>Quitar</button></div>{% endfor %}</div>
  <datalist id="topics"><option>Pedidos</option><option>Entregas</option><option>Pagos</option><option>Conservación</option><option>Devoluciones</option></datalist></div>

{% elif tab == 'servicios' %}
 <div class="cols-2e">{% for k in ['epigenetica', 'thermomix'] %}{% set s = c[k] %}
  <div class="box"><header><h2>{{ s.title }}</h2><a href="/{{ k }}" target="_blank">Ver página</a></header>
   <div class="g2">{{ field(k ~ '[title]','Título',s.title) }}{{ field(k ~ '[price]','Precio o condición',s.price) }}</div>
   {{ area(k ~ '[lead]','Introducción',s.lead,'',3) }}
   <div class="actions-row" style="justify-content:space-between;margin:6px 0 8px"><b>Puntos destacados</b><button type="button" class="btn sm ghost" data-addrow-to="pts-{{ k }}">Agregar</button></div>
   <div id="pts-{{ k }}" data-rows class="list">{% for p in s.points %}<div data-row style="border-bottom:1px solid var(--linea);padding-bottom:10px"><input class="input" name="{{ k }}[points][{{ loop.index0 }}][title]" value="{{ p.title }}" aria-label="Título" style="margin-bottom:6px"><textarea class="input" name="{{ k }}[points][{{ loop.index0 }}][text]" rows="2" aria-label="Texto">{{ p.text }}</textarea><button type="button" class="btn sm ghost" data-delrow style="margin-top:6px">Quitar</button></div>{% endfor %}</div>
  </div>{% endfor %}</div>

{% elif tab == 'legales' %}
 <div class="cols-2e"><div class="box">{{ area('terms','Términos y condiciones',c.legal.terms|join('\n\n'),'Un párrafo por cláusula, separados por una línea en blanco.',16) }}</div>
  <div class="box">{{ area('privacy','Política de privacidad',c.legal.privacy|join('\n\n'),'Un párrafo por punto, separados por una línea en blanco.',16) }}</div></div>

{% elif tab == 'novedades' %}
 <div class="box"><header><h2>Novedades del inicio</h2><button type="button" class="btn sm ghost" data-addrow-to="news">Agregar novedad</button></header>
  <div id="news" data-rows class="list">{% for n in c.news %}<div data-row class="g3" style="grid-template-columns:160px 1fr 2fr auto;gap:8px;align-items:start">
   <input class="input" type="date" name="news[{{ loop.index0 }}][date]" value="{{ n.date }}" aria-label="Fecha"><input class="input" name="news[{{ loop.index0 }}][title]" value="{{ n.title }}" aria-label="Título"><input class="input" name="news[{{ loop.index0 }}][text]" value="{{ n.text }}" aria-label="Texto"><button type="button" class="btn sm ghost" data-delrow>Quitar</button></div>{% endfor %}</div></div>
{% endif %}
 <div class="actions-row"><button class="btn">Publicar cambios</button><span class="small muted">Se publican al instante. «Restablecer demo» en el resumen vuelve a los textos originales.</span></div>
</form>
{% endblock %}
