{% extends 'layouts/base.njk' %}{% block content %}<section class="admin-page"><div class="admin-page-head"><div><a href="/admin">← Administración</a><h1>{{label}}</h1></div><a class="btn dark" href="/admin/{{key}}/nuevo">+ Nuevo</a></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Nombre / Estado</th><th>Detalle</th><th></th></tr></thead><tbody>{% for i in items %}<tr><td>{{i.id}}</td><td><b>{{i.name or i.status or ('Pedido #' + i.id)}}</b></td><td>{{i.category or i.email or i.deliveryDate or i.phone or i.date or ''}}</td><td class="row-actions"><a href="/admin/{{key}}/{{i.id}}/editar">Editar</a><form method="post" action="/admin/{{key}}/{{i.id}}/eliminar"><button>Eliminar</button></form></td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
