{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import field %}
{% block title %}Usuarios y roles{% endblock %}{% block heading %}Usuarios y roles{% endblock %}
{% block body %}
{% set roles = {'admin': 'Administración', 'client': 'Cliente', 'delivery': 'Repartidor'} %}
<div class="cols-2">
 <div class="box"><header><h2>Usuarios con acceso</h2><span class="small muted">{{ users|length }} en total</span></header>
  <div class="table-wrap"><table class="t cards"><thead><tr><th>Persona</th><th>Rol</th><th>Vinculado a</th><th>Estado</th><th></th></tr></thead><tbody>
  {% for u in users %}<tr{% if not u.active %} style="opacity:.55"{% endif %}>
   <td><b>{{ u.name }}</b>{% if u.id == user.id %} <span class="small muted">(vos)</span>{% endif %}<br><span class="small muted">{{ u.email }}</span></td>
   <td><form method="post" action="/admin/usuarios/{{ u.id }}" class="inline"><input type="hidden" name="action" value="role"><select class="input" name="role" data-autosubmit style="min-height:34px;width:auto" aria-label="Rol de {{ u.name }}" {% if u.id == user.id %}disabled{% endif %}>{% for k, v in roles %}<option value="{{ k }}" {% if u.role == k %}selected{% endif %}>{{ v }}</option>{% endfor %}</select></form></td>
   <td class="small">{% if u.clientId and u.link %}<a href="/admin/clientes/{{ u.clientId }}">Ficha de {{ u.link.name }}</a>{% elif u.delivererId and u.link %}<a href="/admin/repartidores">Repartidor: {{ u.link.name }}</a>{% else %}<span class="muted">Equipo</span>{% endif %}</td>
   <td><span class="pill {{ 'ok' if u.active else 'muted' }}">{{ 'Activo' if u.active else 'Inactivo' }}</span></td>
   <td><div class="actions-row" style="justify-content:flex-end;flex-wrap:nowrap">
    <form method="post" action="/admin/usuarios/{{ u.id }}" class="inline"><input type="hidden" name="action" value="password"><button class="btn sm ghost" data-confirm="Generar una contraseña temporal para {{ u.name }}?">Nueva contraseña</button></form>
    {% if u.id != user.id %}<form method="post" action="/admin/usuarios/{{ u.id }}" class="inline"><input type="hidden" name="action" value="toggle"><button class="btn sm ghost">{{ 'Desactivar' if u.active else 'Activar' }}</button></form>{% endif %}
   </div></td></tr>{% endfor %}
  </tbody></table></div>
 </div>
 <div>
  <form class="box" method="post" action="/admin/usuarios" data-userform><header><h2>Nuevo usuario</h2></header>
   {{ field('name','Nombre',null,'text','',true) }}{{ field('email','Email',null,'email','Lo usa para ingresar.',true) }}
   <label class="field"><span>Rol</span><select name="role" data-role>{% for k, v in roles %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></label>
   <div data-for="delivery" hidden><label class="field"><span>Repartidor</span><select name="delivererId"><option value="">Crear un repartidor nuevo con este nombre</option>{% for r in riders %}<option value="{{ r.id }}">{{ r.name }}</option>{% endfor %}</select></label></div>
   <div data-for="client" hidden>{{ field('phone','Teléfono','','tel','Se crea también su ficha de cliente.') }}</div>
   {{ field('password','Contraseña inicial',null,'text','Mínimo 6 caracteres. Pedile que la cambie al ingresar.',true,'minlength="6" autocomplete="off"') }}
   <button class="btn">Crear usuario</button>
  </form>
  <div class="box"><header><h2>Qué puede hacer cada rol</h2></header>
   <dl class="kv"><dt>Administración</dt><dd>Todo el panel: pedidos, catálogo, stock, clientes, repartidores, ventas, configuración y usuarios.</dd>
   <dt>Repartidor</dt><dd>Solo la app de reparto en <a href="/repartidor">/repartidor</a>: sus entregas, ruta y cambios de estado.</dd>
   <dt>Cliente</dt><dd>Su cuenta en <a href="/mi-cuenta">/mi-cuenta</a>: pedidos, seguimiento, direcciones, favoritos y consultas.</dd></dl></div>
 </div>
</div>
{% endblock %}
{% block scripts %}<script>(function(){const f=document.querySelector('[data-userform]'),s=f.querySelector('[data-role]');const up=()=>f.querySelectorAll('[data-for]').forEach(d=>d.hidden=d.dataset.for!==s.value);s.addEventListener('change',up);up()})();</script>{% endblock %}
