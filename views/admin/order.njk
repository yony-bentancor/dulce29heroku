{% extends 'layouts/admin.njk' %}{% from 'partials/macros.njk' import badge, timeline, icon %}
{% block title %}Pedido #{{ o.code }}{% endblock %}{% block heading %}Pedido #{{ o.code }}{% endblock %}
{% block actions %}{{ badge(o.status) }}<a class="btn sm ghost" href="/admin/pedidos">Volver</a>{% endblock %}
{% block body %}
<p class="muted" style="margin-top:0">Creado {{ o.createdAt|datetime }} por {{ o.history[0].by }} · canal {{ o.channel }} · <a class="link" href="/seguimiento/{{ o.code }}?t={{ o.token }}" target="_blank">enlace de seguimiento del cliente</a></p>
{{ timeline(o) }}
<div class="box"><header><h2>Acciones</h2></header><div class="actions-row">
 {% if next %}<form method="post" action="/admin/pedidos/{{ o.id }}/estado"><input type="hidden" name="status" value="{{ next }}"><button class="btn">Pasar a {{ next|status|lower }}</button></form>{% endif %}
 <form class="actions-row" method="post" action="/admin/pedidos/{{ o.id }}/estado"><select class="input" name="status" style="min-height:40px;width:auto" aria-label="Cambiar estado">{% for s, v in STATUS %}<option value="{{ s }}" {% if s == o.status %}selected{% endif %}>{{ v.label }}</option>{% endfor %}</select><input class="input" name="note" placeholder="Motivo (opcional)" style="min-height:40px;width:200px"><button class="btn sm ghost">Cambiar estado</button></form>
 <a class="btn sm wa" href="{{ wa }}" target="_blank" rel="noopener">{{ icon('wa') }} Escribir al cliente</a>
 {% if o.status == 'listo' or o.status == 'en_camino' %}<a class="btn sm ghost" href="{{ waReady }}" target="_blank" rel="noopener">Avisar que salió / está listo</a>{% endif %}
</div></div>
<div class="cols-2">
 <div>
  <div class="box"><header><h2>Productos</h2></header>
   <div class="table-wrap" style="border:0"><table class="t"><thead><tr><th>Producto</th><th class="r">Cant.</th><th class="r">Precio</th><th class="r">Subtotal</th></tr></thead><tbody>
   {% for i in o.items %}<tr><td>{{ i.name }}{% if i.promo %} <span class="pill">pack</span><br><span class="tiny muted">{{ i.promoLines }}</span>{% endif %}{% if i.product and i.product.stock <= 0 %} <span class="pill bad">sin stock ahora</span>{% endif %}</td><td class="r">{{ i.qty }}</td><td class="r num">{{ i.price|money }}</td><td class="r num">{{ (i.price*i.qty)|money }}</td></tr>{% endfor %}
   <tr><td colspan="3" class="r muted">Envío</td><td class="r num">{{ o.shipping|money }}</td></tr><tr><td colspan="3" class="r"><b>Total</b></td><td class="r num"><b>{{ o.total|money }}</b></td></tr></tbody></table></div></div>
  <div class="box"><header><h2>Historial y notas</h2></header>
   <ul class="history">{% for h in o.history|reverse %}<li><time>{{ h.at|datetime }}</time><span>{% if not h.internal %}<b>{{ h.status|status }}</b> · {% endif %}{{ h.by }}{% if h.note %}<br><span class="{{ 'muted' if not h.internal }}">{% if h.internal %}📝 {% endif %}{{ h.note }}</span>{% endif %}</span></li>{% endfor %}</ul>
   <form class="actions-row" method="post" action="/admin/pedidos/{{ o.id }}/nota" style="margin-top:14px"><input class="input" name="note" placeholder="Nota interna (no la ve el cliente)" style="flex:1;min-height:40px"><button class="btn sm">Agregar nota</button></form></div>
 </div>
 <div>
  <div class="box"><header><h2>Cliente</h2>{% if o.client %}<a class="link" href="/admin/clientes/{{ o.client.id }}">Ficha</a>{% endif %}</header><dl class="kv"><dt>Nombre</dt><dd>{{ o.customer.name }}</dd><dt>Teléfono</dt><dd><a class="link" href="tel:{{ o.customer.phone }}">{{ o.customer.phone }}</a></dd>{% if o.customer.email %}<dt>Email</dt><dd>{{ o.customer.email }}</dd>{% endif %}<dt>Pedidos</dt><dd>{{ clientOrders }}</dd>{% if o.client and o.client.notes %}<dt>Notas</dt><dd>{{ o.client.notes }}</dd>{% endif %}</dl>{% if o.notes %}<p class="small" style="background:#FFF6DF;padding:10px;border-radius:8px;margin:12px 0 0"><b>Observaciones del pedido:</b> {{ o.notes }}</p>{% endif %}</div>
  <div class="box"><header><h2>Pago</h2>{% if o.payment.status == 'pagado' %}<span class="pill ok">Pagado</span>{% else %}<span class="pill warn">Pendiente</span>{% endif %}</header>
   <form class="actions-row" method="post" action="/admin/pedidos/{{ o.id }}/pago"><select class="input" name="method" style="min-height:40px;width:auto">{% for m in ['Efectivo','Transferencia','Mercado Pago'] %}<option {% if m == o.payment.method %}selected{% endif %}>{{ m }}</option>{% endfor %}</select><input type="hidden" name="status" value="{{ 'pendiente' if o.payment.status == 'pagado' else 'pagado' }}"><button class="btn sm {{ 'ghost' if o.payment.status == 'pagado' }}">{{ 'Marcar como pendiente' if o.payment.status == 'pagado' else 'Marcar como pagado' }}</button></form></div>
  <div class="box"><header><h2>Entrega</h2></header>
   {% if o.delivery.method == 'envio' %}<form class="actions-row" method="post" action="/admin/pedidos/{{ o.id }}/asignar" style="margin-bottom:14px"><select class="input" name="delivererId" style="min-height:40px;flex:1"><option value="">Sin repartidor</option>{% for d in deliverers %}<option value="{{ d.id }}" {% if o.delivererId == d.id %}selected{% endif %}>{{ d.name }} · {{ d.vehicle }}</option>{% endfor %}</select><button class="btn sm">Asignar</button></form>{% endif %}
   <form method="post" action="/admin/pedidos/{{ o.id }}/entrega">
    <div class="g2"><label class="field"><span>Modalidad</span><select name="method"><option value="envio" {% if o.delivery.method == 'envio' %}selected{% endif %}>Envío</option><option value="retiro" {% if o.delivery.method == 'retiro' %}selected{% endif %}>Retiro</option></select></label><label class="field"><span>Zona</span><select name="zone"><option value="">—</option>{% for z in zones %}<option {% if z.name == o.delivery.zone %}selected{% endif %}>{{ z.name }}</option>{% endfor %}</select></label></div>
    <label class="field"><span>Dirección</span><input name="street" value="{{ o.delivery.street }}"></label>
    <div class="g2"><label class="field"><span>Día</span><input type="date" name="date" value="{{ o.delivery.date }}"></label><label class="field"><span>Horario</span><select name="slot">{% for s in slots %}<option {% if s == o.delivery.slot %}selected{% endif %}>{{ s }}</option>{% endfor %}</select></label></div>
    <label class="field"><span>Referencias</span><input name="notes" value="{{ o.delivery.notes }}"></label>
    <button class="btn sm ghost">Guardar entrega</button></form>
   {% if o.delivery.lat %}<p style="margin:12px 0 0"><a class="link small" href="https://www.google.com/maps/search/?api=1&query={{ o.delivery.lat }},{{ o.delivery.lng }}" target="_blank" rel="noopener">Abrir en Google Maps</a></p>{% endif %}</div>
 </div>
</div>
{% endblock %}
