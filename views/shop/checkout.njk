{% extends 'layouts/base.njk' %}{% block content %}<section class="page-head compact"><span class="eyebrow">ÚLTIMO PASO</span><h1>Coordinar pedido</h1></section><section class="checkout"><form><label>Nombre<input placeholder="Tu nombre"></label><label>Teléfono<input placeholder="09..."></label><label>Dirección<input placeholder="Dirección de entrega"></label><label>Forma de pago<select><option>Transferencia</option><option>Efectivo</option><option>Mercado Pago</option></select></label><label>Notas<textarea placeholder="Horario, indicaciones..."></textarea></label><a class="btn dark full" href="https://wa.me/{{brand.WHATSAPP}}?text=Hola%20Dulce29,%20quiero%20confirmar%20mi%20pedido%20por%20$%20{{total}}" target="_blank">Confirmar por WhatsApp · $ {{total}}</a></form><aside><h3>Tu pedido</h3>{% for r in rows %}<p>{{r.qty}} × {{r.p.name}} <b>$ {{r.qty*r.p.price}}</b></p>{% endfor %}</aside></section>{% endblock %}
