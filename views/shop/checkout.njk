{% extends 'layouts/base.njk' %}{% from 'partials/macros.njk' import field, area %}
{% block title %}Finalizar pedido · Dulce29{% endblock %}
{% block content %}
<div class="wrap"><header class="page-head"><nav class="crumbs"><a href="/carrito">Bolsa</a> / Finalizar pedido</nav><h1>Finalizar pedido</h1>
 {% if not client %}<p class="lead">¿Ya compraste antes? <a class="link" href="/ingresar?volver=/checkout">Ingresá</a> y completamos tus datos. También podés seguir sin cuenta.</p>{% endif %}</header>
<form class="two" method="post" action="/checkout" data-checkout novalidate>
 <section>
  {% if errors|length %}<ul class="errors" role="alert">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
  <fieldset class="fs"><legend><span>1</span>Tus datos</legend>
   {{ field('name','Nombre y apellido',v.name,'text','',true,'autocomplete="name"') }}
   <div class="g2">{{ field('phone','Teléfono (WhatsApp)',v.phone,'tel','Lo usamos para coordinar la entrega.',true,'autocomplete="tel" inputmode="tel"') }}{{ field('email','Email (opcional)',v.email,'email','Te mandamos el resumen del pedido.',false,'autocomplete="email"') }}</div>
  </fieldset>
  <fieldset class="fs"><legend><span>2</span>Entrega</legend>
   <div class="choice">
    <label><input type="radio" name="method" value="envio" {% if v.method != 'retiro' %}checked{% endif %}><b>Envío a domicilio</b><small>Colonia del Sacramento</small></label>
    {% if del.pickup %}<label><input type="radio" name="method" value="retiro" {% if v.method == 'retiro' %}checked{% endif %}><b>Retiro en el local</b><small>{{ del.pickupAddress }} · sin costo</small></label>{% endif %}
   </div>
   <div data-ship>
    {% if client and client.addresses|length %}<div class="choice" data-addrs>{% for a in client.addresses %}<label><input type="radio" name="addressId" value="{{ a.id }}" data-street="{{ a.street }}" data-zone="{{ a.zone }}" data-notes="{{ a.notes }}" {% if v.addressId == a.id or (not v.addressId and loop.first) %}checked{% endif %}><b>{{ a.label }}</b><small>{{ a.street }} · {{ a.zone }}</small></label>{% endfor %}<label><input type="radio" name="addressId" value="nueva"><b>Otra dirección</b><small>Escribila abajo</small></label></div>{% endif %}
    <div class="g2">{{ field('street','Dirección',v.street,'text','Calle, número y apartamento.',false,'autocomplete="street-address"') }}
     <label class="field"><span>Zona</span><select name="zone" data-zone><option value="">Elegí tu zona</option>{% for z in zones %}<option value="{{ z.name }}" data-cost="{{ z.cost }}" {% if v.zone == z.name %}selected{% endif %}>{{ z.name }} · {{ 'sin costo' if z.cost == 0 else (z.cost|money) }}</option>{% endfor %}</select><small>Envío sin costo desde {{ del.freeFrom|money }}.</small></label></div>
    {{ field('addrNotes','Referencias para encontrar la casa',v.addrNotes,'text','Portón, timbre, entre calles…') }}
    {% if client %}<label class="check small" style="margin-bottom:16px"><input type="checkbox" name="saveAddress" value="1"> Guardar esta dirección en mi cuenta</label>{% endif %}
   </div>
   <div class="g2">
    <label class="field"><span>Día</span><select name="date">{% for d in dates %}<option value="{{ d.iso }}" {% if v.date == d.iso %}selected{% endif %}>{{ d.label }}</option>{% endfor %}</select><small>Pedidos antes de las {{ del.cutoff }} h llegan en el día.</small></label>
    <label class="field"><span>Horario</span><select name="slot">{% for s in slots %}<option {% if v.slot == s %}selected{% endif %}>{{ s }}</option>{% endfor %}</select></label>
   </div>
  </fieldset>
  <fieldset class="fs"><legend><span>3</span>Pago</legend>
   <div class="choice">
    {% if pay.transfer.on %}<label><input type="radio" name="payment" value="Transferencia" {% if v.payment == 'Transferencia' %}checked{% endif %}><b>Transferencia</b><small>{{ pay.transfer.bank }}</small></label>{% endif %}
    {% if pay.mercadopago.on %}<label><input type="radio" name="payment" value="Mercado Pago" {% if v.payment == 'Mercado Pago' %}checked{% endif %}><b>Mercado Pago</b><small>Te enviamos el link</small></label>{% endif %}
    {% if pay.cash.on %}<label><input type="radio" name="payment" value="Efectivo" {% if v.payment == 'Efectivo' %}checked{% endif %}><b>Efectivo</b><small>Al recibir</small></label>{% endif %}
   </div>
   {{ area('notes','Observaciones',v.notes,'Cambio para efectivo, alergias, botellas para devolver…',3) }}
  </fieldset>
 </section>
 <aside class="panel sticky"><h3>Tu pedido</h3>
  {% for l in lines %}<div class="actions-row small" style="justify-content:space-between;padding:6px 0;flex-wrap:nowrap"><span>{{ l.qty }} × {{ l.name }}</span><span class="num">{{ l.total|money }}</span></div>{% endfor %}
  <div class="sum" style="margin-top:12px;border-top:1px solid var(--linea);padding-top:12px" data-sum data-sub="{{ t.subtotal }}" data-free="{{ del.freeFrom }}">
   <div><span>Productos</span><span>{{ t.subtotal|money }}</span></div>
   <div><span>Envío</span><span data-ship-cost>{{ 'Sin costo' if t.shipping == 0 else (t.shipping|money) }}</span></div>
   <div class="total"><span>Total</span><span data-total>{{ t.total|money }}</span></div></div>
  <button class="btn block" style="margin-top:18px">Confirmar pedido</button>
  <p class="tiny muted" style="margin:12px 0 0">Al confirmar, el pedido queda registrado con un número y descontamos el stock. Después podés coordinar por WhatsApp. Aceptás los <a class="link" href="/terminos">términos</a>.</p>
 </aside>
</form></div>
{% endblock %}
{% block scripts %}<script>
(function(){const f=document.querySelector('[data-checkout]');if(!f)return;const sum=f.querySelector('[data-sum]'),sub=+sum.dataset.sub,free=+sum.dataset.free;
const fmt=n=>'$ '+Math.round(n).toLocaleString('es-UY').replace(/,/g,'.');
function upd(){const m=f.querySelector('[name=method]:checked').value;f.querySelector('[data-ship]').style.display=m==='retiro'?'none':'';
 const o=f.querySelector('[data-zone]').selectedOptions[0];let c=m==='retiro'||!o||!o.dataset.cost?0:+o.dataset.cost;if(sub>=free)c=0;
 f.querySelector('[data-ship-cost]').textContent=c?fmt(c):(m==='envio'&&(!o||!o.value)?'Elegí tu zona':'Sin costo');f.querySelector('[data-total]').textContent=fmt(sub+c);}
f.addEventListener('change',e=>{if(e.target.name==='addressId'){const a=e.target;if(a.value!=='nueva'){f.street.value=a.dataset.street;f.zone.value=a.dataset.zone;f.addrNotes.value=a.dataset.notes}else{f.street.value='';f.street.focus()}}upd()});upd();})();
</script>{% endblock %}
