{% extends 'layouts/base.njk' %}{% block content %}<section class="detail"><div class="detail-image"><img src="{{p.image}}" alt="{{p.name}}"></div><div class="detail-copy"><span class="eyebrow">{{p.category}}</span><h1>{{p.name}}</h1><p>{{p.description}}</p><div class="price">$ {{p.price}}</div><p class="muted">{{p.size}} · Stock {{p.stock}}</p><form method="post" action="/carrito/agregar/{{p.id}}"><button class="btn dark">Agregar al pedido</button></form></div></section>{% endblock %}
