{% extends 'layouts/base.njk' %}{% block content %}<section class="page-head compact"><span class="eyebrow">TU PEDIDO</span><h1>Bolsa</h1></section><section class="cart-page">{% if rows.length %}<div>{% for row in rows %}<article class="cart-row"><img src="{{row.p.image}}"><div><h3>{{row.p.name}}</h3><p>{{row.qty}} × $ {{row.p.price}}</p></div><strong>$ {{row.p.price * row.qty}}</strong><form method="post" action="/carrito/eliminar/{{row.p.id}}"><button class="link-danger">Quitar</button></form></article>{% endfor %}</div><aside><small>TOTAL</small><div class="price">$ {{total}}</div><a class="btn dark full" href="/checkout">Continuar</a></aside>{% else %}<div class="empty"><h2>Tu bolsa está vacía.</h2><a class="btn" href="/productos">Ver productos</a></div>{% endif %}</section>{% endblock %}
