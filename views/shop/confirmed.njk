{% extends 'layouts/base.njk' %}{% from 'partials/macros.njk' import icon %}
{% block title %}Pedido #{{ o.code }} confirmado · Dulce29{% endblock %}
{% block content %}
<div class="wrap confirm">
 <div class="seal">{{ icon('check') }}</div>
 <h1>Pedido #{{ o.code }} creado</h1>
 <p class="lead" style="margin:16px auto 0">Gracias, {{ o.customer.name.split(' ')[0] }}. Tu pedido ya está registrado y lo estamos preparando.</p>
 <div class="facts">
  <div><small>Total</small><b>{{ o.total|money }}</b></div>
  <div><small>{{ 'Retiro' if o.delivery.method == 'retiro' else 'Entrega' }}</small><b>{{ o.delivery.date|date('long') }}</b><br><span class="small">{{ o.delivery.slot }}</span></div>
  <div><small>Pago</small><b>{{ o.payment.method }}</b><br><span class="small">{{ 'Pendiente' if o.payment.status == 'pendiente' else 'Pagado' }}</span></div>
 </div>
 {% if o.payment.method == 'Transferencia' %}<div class="panel" style="text-align:left;margin-bottom:20px"><b>Datos para transferir</b><p class="small" style="margin:8px 0 0">{{ pay.transfer.bank }} · Cuenta {{ pay.transfer.account }} · {{ pay.transfer.holder }}<br>Importe: <b>{{ o.total|money }}</b> · Referencia: pedido {{ o.code }}<br>{{ pay.transfer.note }}</p></div>
 {% elif o.payment.method == 'Mercado Pago' %}<div class="panel" style="text-align:left;margin-bottom:20px"><b>Pago con Mercado Pago</b><p class="small" style="margin:8px 0 12px">{{ pay.mercadopago.note }}</p><a class="btn sm ghost" href="{{ pay.mercadopago.link }}" target="_blank" rel="noopener">Pagar {{ o.total|money }} con Mercado Pago</a></div>{% endif %}
 <div class="actions-row" style="justify-content:center"><a class="btn wa" href="{{ wa }}" target="_blank" rel="noopener">{{ icon('wa') }} Coordinar por WhatsApp</a><a class="btn ghost" href="{{ trackUrl }}">Seguir el pedido</a></div>
 <div class="panel" style="text-align:left;margin-top:32px"><h3>Detalle</h3>
  {% for i in o.items %}<div class="actions-row small" style="justify-content:space-between;padding:6px 0"><span>{{ i.qty }} × {{ i.name }}</span><span class="num">{{ (i.price*i.qty)|money }}</span></div>{% endfor %}
  <div class="sum" style="margin-top:10px;border-top:1px solid var(--linea);padding-top:10px"><div><span>Envío</span><span>{{ 'Sin costo' if o.shipping == 0 else (o.shipping|money) }}</span></div><div class="total"><span>Total</span><span>{{ o.total|money }}</span></div></div>
  <p class="small muted" style="margin:14px 0 0">{% if o.delivery.method == 'envio' %}Entrega en {{ o.delivery.street }} ({{ o.delivery.zone }}).{% else %}Retiro en {{ settings.delivery.pickupAddress }}.{% endif %} Guardá este enlace para seguir el pedido: <a class="link" href="{{ trackUrl }}">seguimiento #{{ o.code }}</a></p>
 </div>
 {% if not user %}<p class="small muted" style="margin-top:24px"><a class="link" href="/registrarse?tel={{ o.customer.phone }}&nombre={{ o.customer.name }}&email={{ o.customer.email }}">Creá una cuenta</a> para ver tus pedidos y volver a pedir en un clic.</p>{% endif %}
</div>
{% endblock %}
