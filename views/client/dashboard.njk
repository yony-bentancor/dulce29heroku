{% extends 'layouts/base.njk' %}{% block content %}<section class="dashboard-head"><div><span class="eyebrow">MI DULCE29</span><h1>Hola, {{client.name.split(' ')[0]}}.</h1><p>{{client.address}}</p></div><a class="btn" href="/productos">Nuevo pedido</a></section><section class="panel"><h2>Mis pedidos</h2>{% for o in orders %}<article class="order"><div><small>PEDIDO #{{o.id}}</small><h3>{{o.status}}</h3><p>{{o.deliveryDate}}</p></div><div>{% for i in o.items %}<span>{{i.qty}} × {{i.product.name}}</span>{% endfor %}</div><strong>$ {{o.total}}</strong></article>{% endfor %}</section>{% endblock %}
