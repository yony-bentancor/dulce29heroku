{% extends 'layouts/base.njk' %}{% from 'partials/macros.njk' import field, area %}
{% block title %}{{ page.title }} · Dulce29{% endblock %}
{% block content %}
<div class="wrap">
 <div class="svc-hero">
  <div><nav class="crumbs"><a href="/">Inicio</a> / {{ page.title }}</nav><h1>{{ page.title }}</h1><p class="lead" style="margin-top:18px">{{ page.lead }}</p>
   <p class="price-tag" style="margin:24px 0">{{ page.price }}</p><a class="btn" href="#form">{{ 'Consultar y agendar' if kind == 'epigenetica' else 'Pedir una demostración' }}</a></div>
  <img src="{{ 'https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=1200&q=80' if kind == 'epigenetica' else 'https://images.unsplash.com/photo-1556911220-bff31c812dba?auto=format&fit=crop&w=1200&q=80' }}" alt="" onerror="this.style.background='#E9DCCF';this.removeAttribute('src')">
 </div>
 <div class="svc-points">{% for pt in page.points %}<div><b>{{ pt.title }}</b><p class="muted">{{ pt.text }}</p></div>{% endfor %}</div>
 <section class="section" id="form" style="max-width:720px">
  <h2>{{ 'Consultá por el test' if kind == 'epigenetica' else 'Agendá una demostración' }}</h2><p class="lead" style="margin:12px 0 28px">Te contactamos para coordinar día y horario. La consulta queda registrada{% if user %} en tu cuenta, en «Mis consultas»{% endif %}.</p>
  {% if sent %}<div class="flash" style="margin:0 0 20px;width:auto">Recibimos tu consulta. Te escribimos dentro de las próximas 24 h.</div>{% endif %}
  {% if errors %}<ul class="errors">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
  <form method="post" action="/{{ kind }}">
   {{ field('name','Nombre',values.name or (user.name if user),'text','',true) }}
   <div class="g2">{{ field('phone','Teléfono',values.phone,'tel') }}{{ field('email','Email',values.email or (user.email if user),'email') }}</div>
   <label class="field"><span>¿Cuándo te queda mejor?</span><select name="preferred">{% for o in ['Mañanas','Tardes','Fin de semana','Me da igual'] %}<option {% if values.preferred == o %}selected{% endif %}>{{ o }}</option>{% endfor %}</select></label>
   {{ area('message','Contanos qué te interesa (opcional)',values.message,'',3) }}
   <button class="btn">Enviar consulta</button></form>
 </section>
</div>
{% endblock %}
