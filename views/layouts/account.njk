{% extends 'layouts/base.njk' %}
{% block content %}
<div class="wrap acct">
 <nav aria-label="Mi cuenta">
  <div class="who"><i class="avatar">{{ c.name|initials }}</i><div><b>{{ c.name }}</b><br><span class="tiny muted">Cliente desde {{ c.createdAt|date('full') }}</span></div></div>
  {% for l in [['inicio','/mi-cuenta','Resumen'],['pedidos','/mi-cuenta/pedidos','Mis pedidos'],['repetir','/mi-cuenta/volver-a-pedir','Volver a pedir'],['favoritos','/mi-cuenta/favoritos','Favoritos'],['direcciones','/mi-cuenta/direcciones','Direcciones'],['consultas','/mi-cuenta/consultas','Mis consultas'],['datos','/mi-cuenta/datos','Mis datos']] %}
  <a href="{{ l[1] }}" {% if section == l[0] %}aria-current="page"{% endif %}>{{ l[2] }}</a>{% endfor %}
  <a href="/salir">Cerrar sesión</a>
 </nav>
 <section>{% block account %}{% endblock %}</section>
</div>
{% endblock %}
