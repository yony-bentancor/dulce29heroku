<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Administración{% endblock %} · Dulce29</title><meta name="robots" content="noindex"><link rel="icon" href="/images/brand/logo-dulce29.svg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/d29.css">{% block head %}{% endblock %}</head>
<body>{% from 'partials/macros.njk' import icon %}
<div class="admin">
 <aside class="side-nav" aria-label="Administración">
  <a class="brand" href="/admin"><img src="/images/brand/logo-dulce29-blanco.svg" alt="Dulce29"></a>
  {% set groups = [
   ['Operación', [['/admin','Resumen',null],['/admin/pedidos','Pedidos',nav.nuevos],['/admin/pedidos/nuevo','Nuevo pedido',null],['/admin/entregas','Entregas',nav.sinAsignar],['/admin/mapa','Mapa de entregas',null]]],
   ['Catálogo', [['/admin/productos','Productos',null],['/admin/categorias','Categorías',null],['/admin/stock','Stock',nav.stock],['/admin/promociones','Promociones y packs',null]]],
   ['Personas', [['/admin/clientes','Clientes',null],['/admin/repartidores','Repartidores',null],['/admin/consultas','Consultas',nav.consultas],['/admin/epigenetica','Epigenética',nav.epi],['/admin/thermomix','Thermomix',nav.thx]]],
   ['Negocio', [['/admin/ventas','Ventas',null],['/admin/reportes','Reportes',null],['/admin/contenido','Contenido web',null],['/admin/configuracion','Configuración',null],['/admin/usuarios','Usuarios y roles',null]]]
  ] %}
  {% for g in groups %}<h6>{{ g[0] }}</h6>{% for l in g[1] %}<a href="{{ l[0] }}" {% if path == l[0] or (l[0] != '/admin' and l[0] != '/admin/pedidos' and path.startsWith(l[0])) or (l[0] == '/admin/pedidos' and path.startsWith('/admin/pedidos') and path != '/admin/pedidos/nuevo') %}aria-current="page"{% endif %}>{{ l[1] }}{% if l[2] %}<b>{{ l[2] }}</b>{% endif %}</a>{% endfor %}{% endfor %}
  <div class="foot"><p style="margin:0 0 8px">{{ user.name }} · administración</p><a href="/" target="_blank">Ver la tienda</a><a href="/salir">Cerrar sesión</a></div>
 </aside>
 <div class="admin-main">
  <div class="topbar"><button class="iconbtn menu-btn" data-side-toggle aria-label="Menú">{{ icon('menu') }}</button><h1>{% block heading %}{% endblock %}</h1>{% block actions %}{% endblock %}</div>
  {% if flash %}<div class="flash {{ flash.type }}" style="width:auto;margin:16px 28px 0" role="status">{{ flash.text }}</div>{% endif %}
  <div class="admin-body">{% block body %}{% endblock %}</div>
 </div>
</div>
<div class="toast" role="status" aria-live="polite" data-toast></div>
<script src="/js/app.js"></script>
<script>/* aviso de pedidos nuevos en vivo */(function(){let last={{ nav.lastOrderId }};const t=document.querySelector('[data-toast]');
setInterval(async()=>{try{const r=await fetch('/admin/api/novedades?since='+last);const j=await r.json();if(j.orders.length){last=j.last;const o=j.orders[j.orders.length-1];window.toast(`<b>Nuevo pedido #${o.code}</b> · ${o.name.replace(/</g,'')} · ${o.total} <a href="/admin/pedidos/${o.id}">Abrir</a>`,9000);document.title='● '+document.title.replace(/^● /,'')}}catch(e){}},8000)})();</script>
{% block scripts %}{% endblock %}
</body></html>
