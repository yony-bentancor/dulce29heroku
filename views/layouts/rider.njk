<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{% block title %}Reparto{% endblock %} · Dulce29</title><meta name="robots" content="noindex"><meta name="theme-color" content="#0E3B2E"><link rel="icon" href="/images/brand/logo-dulce29.svg">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/css/d29.css">{% block head %}{% endblock %}</head>
<body class="rider-body">
<div class="rider">
 <header>{% block back %}<a href="/repartidor" aria-label="Inicio de reparto"><img src="/images/brand/logo-dulce29-blanco.svg" alt="Dulce29"></a>{% endblock %}
  <h1>{% block heading %}Reparto{% endblock %}</h1>
  <details class="rider-me"><summary aria-label="Mi sesión">{{ rider.name|initials }}</summary><div><b>{{ rider.name }}</b><span>{{ rider.vehicle }} · {{ rider.zones|join(', ') }}</span><a href="/salir">Cerrar sesión</a></div></details>
 </header>
 {% if flash %}<div class="flash {{ flash.type }}" style="width:auto;margin:12px 16px 0" role="status">{{ flash.text }}</div>{% endif %}
 <main>{% block body %}{% endblock %}</main>
 <nav class="tabbar" aria-label="Reparto">
  <a href="/repartidor" {% if path == '/repartidor/' or path == '/repartidor' %}aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/></svg>Hoy</a>
  <a href="/repartidor/entregas" {% if path.startsWith('/repartidor/entregas') %}aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Entregas{% if pending %}<i class="tb-badge">{{ pending }}</i>{% endif %}</a>
  <a href="/repartidor/ruta" {% if path == '/repartidor/ruta' %}aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"/></svg>Ruta</a>
  <a href="/repartidor/historial" {% if path == '/repartidor/historial' %}aria-current="page"{% endif %}><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>Historial</a>
 </nav>
</div>
<div class="toast" role="status" aria-live="polite" data-toast></div>
<script src="/js/app.js"></script>{% block scripts %}{% endblock %}
</body></html>
