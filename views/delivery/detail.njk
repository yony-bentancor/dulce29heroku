{% extends 'layouts/rider.njk' %}{% from 'partials/macros.njk' import icon, timeline %}
{% block title %}Pedido #{{ o.code }}{% endblock %}{% block heading %}#{{ o.code }}{% endblock %}
{% block back %}<a class="rback" href="/repartidor/entregas" aria-label="Volver a entregas"><svg viewBox="0 0 24 24"><path d="M15 5 8 12l7 7"/></svg></a>{% endblock %}
{% block head %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">{% endblock %}
{% block body %}
<div class="rcard">
 <div class="top" style="display:flex;justify-content:space-between;align-items:center;gap:8px"><span class="pill {{ o.status|tone }}">{{ 'Retirado del local' if (o.picked and o.status == 'listo') else o.status|status }}</span><span class="small muted">{{ o.delivery.date|date }} · {{ o.delivery.slot }}</span></div>
 <h2 class="raddr">{{ o.delivery.street }}</h2>
 <p class="muted" style="margin:0">{{ o.delivery.zone }}</p>
 {% if o.delivery.notes %}<p class="dnote">{{ o.delivery.notes }}</p>{% endif %}
 <div class="bigbtns b3">
  <a class="btn ghost" href="{{ o.maps }}" target="_blank" rel="noopener">Cómo llegar</a>
  <a class="btn ghost" href="{{ o.tel }}">Llamar</a>
  <a class="btn wa" href="{{ waHere if o.status == 'en_camino' else waWay }}" target="_blank" rel="noopener">{{ icon('wa') }} WhatsApp</a>
 </div>
</div>

{% if o.delivery.lat %}<div class="map" style="height:200px;margin:12px 0" data-map data-points="{{ [{lat:o.delivery.lat,lng:o.delivery.lng,label:o.delivery.street,n:'•',color:'#14A06E'}]|dump }}"></div>{% endif %}

<div class="rcard">
 <div class="rhead"><h2>{{ o.customer.name }}</h2><span class="small muted">{{ o.customer.phone }}</span></div>
 {% if o.collect %}<div class="rcash"><span>Cobrar en efectivo</span><b>{{ o.collect|money }}</b></div>
 {% else %}<p class="small" style="margin:0 0 10px"><b>{{ o.payment.method }}</b> · {{ 'ya pagado, no cobrar' if o.payment.status == 'pagado' else 'pago pendiente: lo gestiona administración' }}</p>{% endif %}
 <ul class="ritems">{% for i in o.items %}<li><b>{{ i.qty }}×</b> {{ i.name }}{% if i.promoLines %}<small>{{ i.promoLines }}</small>{% endif %}</li>{% endfor %}</ul>
 {% if o.notes %}<p class="dnote">Nota del cliente: {{ o.notes }}</p>{% endif %}
</div>

{% if free %}
 <form method="post" action="/repartidor/entregas/{{ o.code }}/tomar" class="bigbtns"><button class="btn">Tomar esta entrega</button></form>
{% elif isMine %}
<section class="rcard" id="estado">
 <h2 style="font-size:26px;margin:0 0 4px">Actualizar estado</h2>
 <ol class="rflow">
  <li class="{{ 'done' if o.picked or o.status in ['en_camino','entregado','no_entregado'] }}">Retirado</li>
  <li class="{{ 'done' if o.status in ['en_camino','entregado','no_entregado'] }}{{ ' now' if o.status == 'en_camino' }}">En camino</li>
  <li class="{{ 'done' if o.status == 'entregado' }}{{ ' bad' if o.status == 'no_entregado' }}">{{ 'No entregado' if o.status == 'no_entregado' else 'Entregado' }}</li>
 </ol>
 {% if o.status in ['recibido','preparando','listo'] %}
  <form method="post" action="/repartidor/entregas/{{ o.code }}/estado" class="bigbtns">
   {% if not o.picked %}<button class="btn" name="action" value="retirado">Retiré el pedido del local</button>{% endif %}
   <button class="btn {{ 'green' if o.picked else 'ghost' }}" name="action" value="en_camino">Salgo en camino</button>
   {% if o.status != 'listo' %}<p class="small muted" style="margin:0">En el local figura «{{ o.status|status }}». Confirmá con el local antes de salir.</p>{% endif %}
  </form>
 {% elif o.status == 'en_camino' %}
  <form method="post" action="/repartidor/entregas/{{ o.code }}/estado" id="entregar" class="rform">
   <input type="hidden" name="action" value="entregado">
   <label class="field"><span>¿Quién recibió?</span><input name="receivedBy" placeholder="{{ o.customer.name.split(' ')[0] }}, portero, familiar…"></label>
   {% if o.collect %}<label class="check rbig"><input type="checkbox" name="cash" value="1" checked> Cobré {{ o.collect|money }} en efectivo</label>{% endif %}
   <label class="field"><span>Botellas de vidrio devueltas</span><input type="number" name="bottles" min="0" max="20" value="0" inputmode="numeric"></label>
   <div class="bigbtns"><button class="btn green">Marcar entregado</button></div>
  </form>
  <details class="rfail" id="no-entregado"><summary>No se pudo entregar</summary>
   <form method="post" action="/repartidor/entregas/{{ o.code }}/estado"><input type="hidden" name="action" value="no_entregado">
    <fieldset class="rreasons"><legend class="sr">Motivo</legend>{% for r in reasons %}<label class="check"><input type="radio" name="reason" value="{{ r }}" {% if loop.first %}checked{% endif %}> {{ r }}</label>{% endfor %}</fieldset>
    <label class="field"><span>Detalle (opcional)</span><textarea name="note" rows="2" placeholder="Toqué timbre a las 16:40, dejé aviso…"></textarea></label>
    <div class="bigbtns"><button class="btn danger">Marcar no entregado</button><a class="btn wa" href="{{ waMiss }}" target="_blank" rel="noopener">{{ icon('wa') }} Avisar al cliente</a></div>
   </form></details>
 {% elif o.status == 'no_entregado' %}
  <form method="post" action="/repartidor/entregas/{{ o.code }}/estado" class="bigbtns"><button class="btn" name="action" value="reintentar">Volver a intentar ahora</button></form>
 {% else %}
  <p style="margin:12px 0 0">Entregado {% for h in o.history %}{% if h.status == 'entregado' %}a las {{ h.at|time }}{% endif %}{% endfor %}{% if o.bottlesBack %} · {{ o.bottlesBack }} botellas devueltas{% endif %}.</p>
 {% endif %}
</section>
{% endif %}

<details class="rcard rlog"><summary>Historial del pedido</summary>
 <ul class="notes" style="margin-top:12px">{% for h in o.history | reverse %}<li><time>{{ h.at|datetime }} · {{ h.by }}</time>{{ h.status|status }}{% if h.note %}: {{ h.note }}{% endif %}</li>{% endfor %}</ul></details>
{% endblock %}
{% block scripts %}<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/mapa.js"></script>{% endblock %}
