{% extends 'layouts/rider.njk' %}
{% block title %}Hoy{% endblock %}{% block heading %}Hola, {{ rider.name.split(' ')[0] }}{% endblock %}
{% block body %}
<p class="muted" style="margin:0 0 12px">{{ today|date('full') }}</p>
<div class="rkpis">
 <div><b>{{ k.pending }}</b><small>por entregar</small></div>
 <div><b>{{ k.done }}</b><small>entregadas hoy</small></div>
 <div><b>{{ k.cash|money }}</b><small>efectivo a cobrar</small></div>
</div>

{% if next %}
<section class="rnext">
 <h2>{{ 'En camino a' if next.status == 'en_camino' else 'Próxima entrega' }}</h2>
 {% set o = next %}{% set n = 1 %}{% include 'partials/dcard.njk' %}
 <div class="bigbtns b2">
  <a class="btn ghost" href="{{ next.maps }}" target="_blank" rel="noopener">Cómo llegar</a>
  <a class="btn ghost" href="{{ next.tel }}">Llamar</a>
 </div>
 <form method="post" action="/repartidor/entregas/{{ next.code }}/estado"><input type="hidden" name="volver" value="inicio">
 {% if next.status == 'en_camino' %}
  <div class="bigbtns"><a class="btn green" href="/repartidor/entregas/{{ next.code }}#entregar">Marcar entregado</a></div>
 {% elif next.status == 'listo' and not next.picked %}
  <div class="bigbtns"><button class="btn" name="action" value="retirado">Retiré el pedido del local</button></div>
 {% elif next.status == 'listo' %}
  <div class="bigbtns"><button class="btn green" name="action" value="en_camino">Salgo en camino</button></div>
 {% else %}
  <p class="small muted" style="margin:0">Todavía está {{ next.status|status|lower }} en el local. Si ya lo tenés en la mano, abrilo y marcá «Retiré el pedido».</p>
 {% endif %}
 </form>
</section>
{% else %}
<div class="empty" style="padding:36px 20px"><h3>Sin entregas pendientes</h3><p>Cuando administración te asigne un pedido aparece acá. También podés tomar uno de los disponibles.</p></div>
{% endif %}

{% if queue|length %}
<section style="margin-top:22px"><div class="rhead"><h2>Después</h2><a href="/repartidor/ruta">Ver ruta · {{ k.km }} km</a></div>
 {% for o in queue %}{% set n = loop.index + 1 %}{% include 'partials/dcard.njk' %}{% endfor %}
 {% if more %}<a class="btn ghost block" href="/repartidor/entregas">Ver {{ more }} más</a>{% endif %}
</section>
{% endif %}

{% if available|length %}
<section style="margin-top:22px"><div class="rhead"><h2>Disponibles para tomar</h2><span class="small muted">sin repartidor</span></div>
 {% for o in available %}<div class="dcard"><div class="top"><b>#{{ o.code }}</b><span class="pill {{ o.status|tone }}">{{ o.status|status }}</span></div>
  <div class="addr">{{ o.delivery.street }}</div><div class="meta"><span>{{ o.delivery.zone }}{% if o.delivery.zone in zones %} · tu zona{% endif %}</span><span>{{ o.delivery.slot }}</span><span>{{ o.total|money }}</span></div>
  <form method="post" action="/repartidor/entregas/{{ o.code }}/tomar" style="margin-top:12px"><button class="btn sm">Tomar esta entrega</button></form></div>{% endfor %}
</section>
{% endif %}
{% if k.collected or k.failed %}<p class="small muted" style="margin:20px 0 0">Hoy cobraste {{ k.collected|money }} en efectivo{% if k.failed %} · {{ k.failed }} sin entregar{% endif %}. <a href="/repartidor/historial">Ver historial</a></p>{% endif %}
{% endblock %}
