{% extends 'layouts/base.njk' %}{% block content %}<section class="dashboard-head"><div><span class="eyebrow">REPARTO</span><h1>Entregas de hoy</h1><p>Pedidos asignados a Martín.</p></div></section><section class="delivery-list">{% for o in orders %}<article class="delivery-card"><div><small>#{{o.id}} · {{o.status}}</small><h2>{{o.client.name}}</h2><p>{{o.client.address}}</p><strong>$ {{o.total}}</strong></div><div class="delivery-actions"><a class="btn" href="{{o.map}}" target="_blank">Abrir mapa</a><a class="btn" href="{{o.wa}}" target="_blank">WhatsApp</a><form method="post" action="/repartidor/pedido/{{o.id}}/estado"><select name="status"><option>Pendiente</option><option>En reparto</option><option>Entregado</option></select><button class="btn dark">Actualizar</button></form></div></article>{% endfor %}</section>{% endblock %}
