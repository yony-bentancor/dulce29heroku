{% extends 'layouts/rider.njk' %}
{% block title %}Ruta{% endblock %}{% block heading %}Ruta de hoy{% endblock %}
{% block head %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">{% endblock %}
{% block body %}
<div class="map" style="height:46vh;min-height:300px" data-map data-route="1" data-points="{{ points|dump }}"></div>
<div class="rhead" style="margin-top:14px"><h2>{{ stops|length }} paradas · {{ km }} km aprox.</h2></div>
{% if gmaps %}<div class="bigbtns" style="margin-top:0"><a class="btn" href="{{ gmaps }}" target="_blank" rel="noopener">Abrir la ruta completa en Google Maps</a></div>{% endif %}
<ol class="rsteps"><li><span class="seq" style="background:var(--bosque)">D</span><div><b>Salida: local Dulce29</b><small>{{ biz.address }}</small></div></li>
{% for o in stops %}<li><span class="seq" style="background:{{ '#14A06E' if o.status == 'en_camino' else '#E9B92F' }};color:{{ '#fff' if o.status == 'en_camino' else '#3a2a00' }}">{{ loop.index }}</span><a href="/repartidor/entregas/{{ o.code }}"><b>{{ o.delivery.street }}</b><small>#{{ o.code }} · {{ o.customer.name }} · {{ o.delivery.slot }}{% if o.collect %} · cobrar {{ o.collect|money }}{% endif %}</small></a></li>{% endfor %}
</ol>
{% if not stops|length %}<div class="empty" style="padding:30px 20px">No hay paradas pendientes.</div>{% endif %}
{% endblock %}
{% block scripts %}<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/mapa.js"></script>{% endblock %}
