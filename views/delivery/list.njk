{% extends 'layouts/rider.njk' %}
{% block title %}Mis entregas{% endblock %}{% block heading %}Entregas{% endblock %}
{% block body %}
<nav class="seg rseg" aria-label="Filtro">
 <a href="?ver=hoy" aria-current="{{ 'true' if f == 'hoy' else 'false' }}">Pendientes<small>{{ counts.hoy }}</small></a>
 <a href="?ver=hechas" aria-current="{{ 'true' if f == 'hechas' else 'false' }}">Hechas hoy<small>{{ counts.hechas }}</small></a>
 <a href="?ver=proximas" aria-current="{{ 'true' if f == 'proximas' else 'false' }}">Próximos días<small>{{ counts.proximas }}</small></a>
</nav>
{% if f == 'hoy' and items|length %}<p class="small muted" style="margin:0 0 12px">Ordenadas por cercanía desde el local; lo que ya está en camino va primero.</p>{% endif %}
{% for o in items %}{% set n = loop.index if f == 'hoy' else null %}{% include 'partials/dcard.njk' %}
{% else %}<div class="empty" style="padding:36px 20px"><h3>{{ 'Nada pendiente' if f == 'hoy' else 'Sin entregas en esta vista' }}</h3><p><a href="/repartidor">Volver al inicio</a></p></div>{% endfor %}
{% endblock %}
