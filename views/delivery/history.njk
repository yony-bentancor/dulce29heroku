{% extends 'layouts/rider.njk' %}
{% block title %}Historial{% endblock %}{% block heading %}Historial{% endblock %}
{% block body %}
<nav class="seg rseg" aria-label="Período">{% for d in [[1,'Hoy'],[7,'7 días'],[30,'30 días']] %}<a href="?dias={{ d[0] }}" aria-current="{{ 'true' if days == d[0] else 'false' }}">{{ d[1] }}</a>{% endfor %}</nav>
<div class="rkpis"><div><b>{{ k.ok }}</b><small>entregadas</small></div><div><b>{{ k.rate }}%</b><small>efectividad</small></div><div><b>{{ k.cash|money }}</b><small>cobrado en efectivo</small></div></div>
{% for g in groups %}
<section style="margin-top:18px"><div class="rhead"><h2>{{ 'Hoy' if g.d == today else g.d|date('long') }}</h2><span class="small muted">{{ g.ok }} entregadas{% if g.cash %} · {{ g.cash|money }} efectivo{% endif %}</span></div>
 <div class="rhist">{% for o in g.items %}<a href="/repartidor/entregas/{{ o.code }}"><time>{{ o.at|time }}</time><span><b>#{{ o.code }}</b> {{ o.delivery.street }}<small>{{ o.customer.name }} · {{ o.total|money }} · {{ o.payment.method }}</small></span><span class="pill {{ o.status|tone }}">{{ o.status|status }}</span></a>{% endfor %}</div>
</section>
{% else %}<div class="empty" style="padding:36px 20px;margin-top:16px">Sin entregas cerradas en este período.</div>{% endfor %}
{% endblock %}
