{% extends 'layouts/base.njk' %}{% from 'partials/macros.njk' import field %}
{% block title %}Crear cuenta · Dulce29{% endblock %}
{% block content %}
<div class="auth"><div class="side"><p>Volvé a pedir lo de siempre en un clic.</p></div>
 <div class="form"><div><h1>Crear cuenta</h1><p class="muted">¿Ya tenés cuenta? <a class="link" href="/ingresar">Ingresá</a>. Si ya compraste antes con este teléfono, vas a ver tus pedidos anteriores.</p>
  {% if errors %}<ul class="errors" role="alert">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
  <form method="post" action="/registrarse" style="margin-top:24px">
   {{ field('name','Nombre y apellido',values.name,'text','',true,'autocomplete="name"') }}
   {{ field('email','Email',values.email,'email','',true,'autocomplete="email"') }}
   {{ field('phone','Teléfono',values.phone,'tel','',true,'autocomplete="tel"') }}
   {{ field('password','Contraseña','','password','Mínimo 6 caracteres.',true,'autocomplete="new-password" minlength="6"') }}
   <button class="btn block">Crear mi cuenta</button><p class="tiny muted" style="margin-top:12px">Al crear la cuenta aceptás los <a class="link" href="/terminos">términos</a> y la <a class="link" href="/privacidad">política de privacidad</a>.</p></form>
 </div></div></div>
{% endblock %}
