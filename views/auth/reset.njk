{% extends 'layouts/base.njk' %}{% from 'partials/macros.njk' import field %}
{% block title %}Nueva contraseña · Dulce29{% endblock %}
{% block content %}
<div class="auth"><div class="side"><p>Una contraseña nueva y listo.</p></div>
 <div class="form"><div><h1>Nueva contraseña</h1>
 {% if valid %}{% if error %}<p class="errors" style="padding-left:18px">{{ error }}</p>{% endif %}
  <form method="post" action="/recuperar/{{ token }}" style="margin-top:24px">{{ field('password','Contraseña nueva','','password','Mínimo 6 caracteres.',true,'autocomplete="new-password"') }}{{ field('password2','Repetila','','password','',true,'autocomplete="new-password"') }}<button class="btn">Guardar contraseña</button></form>
 {% else %}<p class="errors" style="padding-left:18px">El enlace venció o ya se usó.</p><a class="btn" href="/recuperar">Pedir un enlace nuevo</a>{% endif %}
 </div></div></div>
{% endblock %}
